#!/usr/bin/env python3
"""Bridge one llm_chat room to Slack, so an agent can escalate to a human.

    llm-chat-slack --check        # is the wiring live? sends nothing
    llm-chat-slack                # run the bridge

WHAT IT IS FOR. An agent that genuinely needs its human has nowhere to put the
question: the human is not in the room, and waiting for them to look is the
thing autonomy was supposed to remove. This makes the human a PARTICIPANT —
agents `join` a room, ask, and get an answer back in the same room, while the
human answers from a phone.

Agents join and leave it like any other room. It is deliberately NOT a broadcast
room: an answer to an escalation SHOULD wake the agent that asked, which is the
whole point, and a room nobody opted into should not be able to do that.

THE LOOP, AND THE TWO WAYS IT COULD EAT ITSELF:

  llm_chat --> Slack   `read` as the human's identity. The self-filter already
                       excludes the human's own lines, so relayed answers cannot
                       be relayed back out. One reader of that rule, not two:
                       this shells out to the CLI rather than querying the store.

  Slack --> llm_chat   Slack has no such filter, so the bridge's OWN posts would
                       come back and be re-posted forever. Bot messages carry
                       `bot_id`; those are skipped. That check is the only thing
                       standing between this and an infinite loop, so it is
                       asserted rather than assumed.

CREDENTIALS live in `.llm_chat/slack.json` (gitignored), and if that is absent
it falls back to `.game_loop/notify.json` — same shape, so a machine that has
already configured Slack once does not do it twice.

    {"room": "someone_human", "identity": "someone",
     "slack": {"bot_token": "xoxb-...", "channel": "C0123456789",
               "poll_sec": 10}}

A bot token is REQUIRED, not a webhook: webhooks are send-only, and the reply
direction is the entire feature. The bot must be a member of the channel and
carry `chat:write` plus the history scope matching the channel TYPE —
`channels:history` for public, `groups:history` for private, `im:history` for a
DM. A `C` id is not proof of a public channel; Slack issues `C` to private ones
too.

CONTENT LEAVES THE MACHINE. Everything else here is loopback with no auth
because it never goes anywhere. This does. Whatever agents say in the bridged
room reaches Slack, and Slack's retention, workspace admins and search apply to
it from then on. Bridge a room you opened for the purpose; do not bridge a
working channel and discover afterwards what was in it.
"""
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

HERE = os.path.dirname(os.path.abspath(__file__))
CLI = os.path.join(HERE, "llm_chat")
ROOT = os.path.dirname(HERE)
STATE = os.path.join(ROOT, ".llm_chat")
CONFIG = os.path.join(STATE, "slack.json")
FALLBACK = os.path.join(ROOT, ".game_loop", "notify.json")
CURSOR = os.path.join(STATE, "slack-cursor.json")
THREADS = os.path.join(STATE, "slack-threads.json")
REPLIES = os.path.join(STATE, "slack-replies.json")
ASKED = os.path.join(STATE, "slack-asked.json")

# Slack does NOT send "@here" in the text. It sends <!here> and <!channel>,
# already parsed, and matching only the literal would be a feature that never
# once fires while looking implemented. Both forms accepted: the raw string is
# what a human sees themselves type.
EVERYONE = re.compile(r"<!(here|channel|everyone)>|(?<!\S)@(here|channel)\b",
                      re.IGNORECASE)
# How a human says "we are done here" from a phone, where there are no flags.
# Deliberately several spellings of one idea, and `nrn` because a thumb typing
# on a phone is the case this exists for. Matched anywhere in the message, so
# it can be appended to a real sentence rather than replacing one.
NO_REPLY_NEEDED = re.compile(
    r"\bno (?:response|reply|answer)(?: is)? (?:needed|required|necessary)\b"
    r"|\bno need to (?:reply|respond|answer)\b"
    r"|\bnrn\b|\bfyi only\b",
    re.IGNORECASE)

MAX_THREADS = 500

# How far back a thread stays worth polling, how many are polled at once, and
# how often any one of them may be re-asked. Together these bound the cost of
# watching threads whose parents have fallen out of the history window — the
# case where nothing cheaper than a request can tell us whether it grew.
# Worst case is MAX_WATCHED_THREADS requests per RECHECK_SEC, deliberately
# well inside Slack's Tier-3 allowance rather than close to it.
# A DAY, not an hour. The count and recheck bounds already cap the cost at
# MAX_WATCHED_THREADS requests per RECHECK_SEC no matter how old the map is,
# so age buys almost nothing and risks the case this bridge exists for: a
# human who reads the question in the evening and answers the next morning.
# Losing that reply would be the original bug wearing a timer.
THREAD_WATCH_SEC = 86400
MAX_WATCHED_THREADS = 10
RECHECK_SEC = 30

# Whether the llm_chat read is currently failing, so the message is printed on
# the TRANSITION rather than on every poll. One bridge per process, so a module
# global is the honest scope for it.
_READ_STATE = {"broken": False}

DEFAULT_POLL_SEC = 10


def load_config():
    """Bridge config, with credentials falling back to game_loop's if present."""
    try:
        with open(CONFIG) as f:
            config = json.load(f) or {}
    except (OSError, ValueError):
        return None
    slack = dict(config.get("slack") or {})
    if not slack.get("bot_token"):
        try:
            with open(FALLBACK) as f:
                slack = {**(json.load(f) or {}).get("slack", {}), **slack}
        except (OSError, ValueError):
            pass
    config["slack"] = slack
    missing = [k for k in ("room", "identity") if not config.get(k)]
    missing += ["slack.%s" % k for k in ("bot_token", "channel")
                if not slack.get(k)]
    if missing:
        config["missing"] = missing
    return config


class Slack:
    """The seam. Everything network lives behind this so the bridge is testable."""

    def __init__(self, token, channel, api="https://slack.com/api"):
        self.token = token
        self.channel = channel
        self.api = api

    def _call(self, method, params=None, body=None):
        url = "%s/%s" % (self.api, method)
        data = None
        headers = {"Authorization": "Bearer " + self.token}
        if body is not None:
            data = json.dumps(body).encode()
            headers["Content-Type"] = "application/json; charset=utf-8"
        elif params:
            url += "?" + urllib.parse.urlencode(params)
        request = urllib.request.Request(url, data=data, headers=headers)
        with urllib.request.urlopen(request, timeout=15) as response:
            return json.loads(response.read().decode())

    def post(self, text, thread_ts=None):
        """Post, into a thread when this is an ANSWER to one.

        Without `thread_ts` every relay is a new root, so a human who asked in
        a thread — the documented way to reach one agent — watches that thread
        stay silent while the answer appears somewhere else in the channel. On
        a phone that is indistinguishable from not being answered at all,
        which is the failure this room exists to prevent, arriving by a
        different route.
        """
        body = {"channel": self.channel, "text": text}
        if thread_ts:
            body["thread_ts"] = thread_ts
        return self._call("chat.postMessage", body=body)

    def history(self, oldest=None):
        params = {"channel": self.channel, "limit": 50}
        if oldest:
            params["oldest"] = oldest
        return self._call("conversations.history", params=params)

    def replies(self, ts):
        """A thread's messages. THE ONLY WAY TO SEE A THREAD REPLY.

        `conversations.history` does not return them — by design, not by
        accident, and it is not an error or an empty result but a correct
        answer to a different question. The parent comes back carrying
        `reply_count`, so history knows they exist and simply does not carry
        them.

        That made the documented PRIMARY reply path — "reply in a thread and
        only the agent who asked is woken" — unreachable from the moment it
        was written. Everything downstream was correct: `route` reads
        `thread_ts`, the thread map is keyed properly. It was never fed. The
        only gesture a human on a phone is told to use was the one gesture
        that could not arrive, on the channel where waiting is the cost.

        Needs no scope the bridge does not already have.
        """
        return self._call("conversations.replies",
                          params={"channel": self.channel, "ts": ts,
                                  "limit": 50})


def read_cursor():
    try:
        with open(CURSOR) as f:
            return (json.load(f) or {}).get("oldest")
    except (OSError, ValueError):
        return None


def write_cursor(ts):
    os.makedirs(os.path.dirname(CURSOR), exist_ok=True)
    tmp = CURSOR + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"oldest": ts}, f)
    os.replace(tmp, CURSOR)


def now():
    """Seam, so the bounds below are testable without sleeping."""
    return time.time()


def watched_parents(threads, seen, hints=None):
    """Parents worth asking about this poll, newest first.

    The thread map is bounded at MAX_THREADS, which is right for "whose thread
    is this" and far too large for "ask Slack about it every ten seconds".

    THE RATE LIMIT APPLIES ONLY TO BLIND PARENTS. When `history` returned the
    parent it also returned `reply_count`, which answers "did it grow?" for
    free — so an in-window thread is fetched the moment it changes and skipped
    entirely when it has not. Rate-limiting those too would delay a reply the
    bridge could already see, by up to RECHECK_SEC, for nothing. Out-of-window
    parents have no such signal: the only way to learn is to ask, so those are
    the ones that need a leash.

      age      bounds how far back the map is worth polling at all
      count    a burst of relays must not become a burst of polling
      recheck  blind parents only, so the poll interval stays the human's
               latency budget rather than Slack's rate limit
    """
    hints = hints or {}
    fresh = now() - THREAD_WATCH_SEC
    due = []
    for ts in threads:
        try:
            when = float(ts)
        except (TypeError, ValueError):
            continue
        if when < fresh:
            continue
        hint = hints.get(ts)
        if hint is not None:
            if hint == 0 or (seen.get(ts) or {}).get("count") == hint:
                continue          # visible, and provably unchanged
            due.append(ts)        # visible, and provably grown: ask now
            continue
        checked = (seen.get(ts) or {}).get("checked_at") or 0
        if now() - checked < RECHECK_SEC:
            continue
        due.append(ts)
    return sorted(due, key=float, reverse=True)[:MAX_WATCHED_THREADS]


def read_asked():
    """{sender: parent_ts} — the thread each agent was most recently asked in.

    The INVERSE of the thread map, and the piece that was missing. That map
    answers "whose thread is this"; this one answers "which thread does this
    agent owe an answer in", which is what the outbound half needs and could
    not derive: by the time an agent replies, the only record was a mapping
    from parents to senders, and searching it backwards would pick the oldest
    thread rather than the one just asked.
    """
    try:
        with open(ASKED) as f:
            return json.load(f) or {}
    except (OSError, ValueError):
        return {}


def write_asked(asked):
    if len(asked) > MAX_THREADS:
        for old in list(asked)[:len(asked) - MAX_THREADS]:
            del asked[old]
    os.makedirs(os.path.dirname(ASKED), exist_ok=True)
    tmp = ASKED + ".tmp"
    with open(tmp, "w") as f:
        json.dump(asked, f)
    os.replace(tmp, ASKED)


def note_question(message, addressing):
    """Record that a human asked THIS agent in THIS thread.

    Only for a message that both names one agent and sits in a thread. An
    `@here` reaches everyone and belongs to no single answer, and a top-level
    message has no thread for a reply to land in.

    A LIST, not a slot. One parent per sender assumed there is only ever one
    outstanding question, and on a host where no wake lands an idle agent
    accumulates messages until it next runs a tool — so two or more pending is
    the DEFAULT state, not a race. With a slot, the next reply attached to
    whichever parent happened to be stored, which was the older one: the human
    watched their newest question sit unanswered in the channel while the
    answer went into a thread they had finished with, sometimes under a message
    that had explicitly said no reply was needed.
    """
    if not addressing or addressing[0] != "--to" or len(addressing) < 2:
        return
    parent = message.get("thread_ts") or message.get("ts")
    if not parent:
        return
    asked = read_asked()
    outstanding = asked.get(addressing[1]) or []
    if isinstance(outstanding, str):
        outstanding = [outstanding]     # a slot written by the older format
    if parent not in outstanding:
        outstanding.append(parent)
    asked[addressing[1]] = outstanding
    write_asked(asked)


def parent_for(asked, sender):
    """The thread an answer from `sender` belongs in, or None to post at root.

    GUESS ONLY WHEN THERE IS NOTHING TO GUESS. With exactly one outstanding
    question the answer is unambiguous and threading it is right — that case
    was confirmed working. With two or more, nothing here knows which one is
    being answered: llm_chat carries no reply-to, so any choice is a coin toss
    with a bad tail.

    Top level is the honest default, and the reasoning is the reporter's: from
    the human's side a misfiled answer is WORSE than no threading at all,
    because with everything top-level they would at least find it. A visible
    answer in the wrong place beats an invisible one in the right-looking
    place.

    Cleared either way. Once the agent has spoken, continuing to hold parents
    would thread some later, unrelated message into a stale conversation.
    """
    outstanding = asked.pop(sender, None) or []
    if isinstance(outstanding, str):
        outstanding = [outstanding]
    return outstanding[0] if len(outstanding) == 1 else None


def read_reply_state():
    """{parent_ts: {"count": N, "seen_ts": ts}} — how far into each thread we
    have relayed. Separate from the thread map because that one answers "whose
    thread is this" and is bounded by relays out; this one answers "what have I
    already carried in" and is bounded by threads with replies."""
    try:
        with open(REPLIES) as f:
            return json.load(f) or {}
    except (OSError, ValueError):
        return {}


def write_reply_state(state):
    if len(state) > MAX_THREADS:
        for old in list(state)[:len(state) - MAX_THREADS]:
            del state[old]
    os.makedirs(os.path.dirname(REPLIES), exist_ok=True)
    tmp = REPLIES + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f)
    os.replace(tmp, REPLIES)


def read_threads():
    try:
        with open(THREADS) as f:
            return json.load(f) or {}
    except (OSError, ValueError):
        return {}


def remember_thread(ts, sender):
    """Map the Slack message we just posted back to the agent who wrote it.

    This is the whole mechanism behind "reply in a thread and only that agent
    is woken": a Slack thread_ts is the ONLY structured signal a human has
    while typing on a phone, and it is worth nothing unless something on this
    side knows which agent that thread belongs to.

    Bounded, because it is written once per relayed message forever. Oldest
    entries drop first — a thread nobody has replied to in five hundred
    messages is not one somebody is about to reply to.
    """
    if not ts or not sender:
        return
    threads = read_threads()
    threads[ts] = sender
    if len(threads) > MAX_THREADS:
        for old in list(threads)[:len(threads) - MAX_THREADS]:
            del threads[old]
    os.makedirs(os.path.dirname(THREADS), exist_ok=True)
    tmp = THREADS + ".tmp"
    with open(tmp, "w") as f:
        json.dump(threads, f)
    os.replace(tmp, THREADS)


def waiting_for_human(room, identity):
    """Agent messages in the room, as (sender, line) pairs.

    Reads through the CLI so the self-filter applies — one reader of that rule,
    not two — and asks for --json, because the sender has to be exactly right:
    it is the key the thread map is written under, and a threaded reply is
    routed by it.

    THE RENDERED TRANSCRIPT IS NOT A PARSEABLE FORMAT. Splitting it on
    "^[name]" reads any body line starting with a bracket as a new speaker, so
    an [INFO] log line pasted as evidence became a separate Slack post
    attributed to a sender that does not exist — and a thread map keyed on a
    phantom routes the human's reply to nobody. Reported against the sibling
    consumer of the same rendering, with a reproduction; this one had the same
    defect and had not been caught yet.

    READ HAS THREE OUTCOMES AND THIS RETURNS ALL THREE. `[]` is "nothing
    waiting"; `None` is "I could not look". They used to be the same value,
    because the exit code was discarded and `json.loads(out or "[]")` turned an
    empty stdout into an empty list.

    That is the exact failure llms.txt documents for every other consumer of
    `read`, and this was the one caller violating it. Measured, by somebody
    else, on a live bridge: the configured identity had never joined the room,
    so every read exited non-zero with nothing on stdout, and the agent->Slack
    direction was dead for the entire session while the bridge printed nothing
    at all. On an escalation path that is the worst possible silence — an agent
    posts a question it believes reached a human, and waits.
    """
    try:
        done = subprocess.run(
            [sys.executable, CLI, "read", room, "--as", identity, "--json"],
            capture_output=True, text=True, timeout=15)
    except Exception:
        return None
    if done.returncode != 0:
        return None
    try:
        records = json.loads((done.stdout or "").strip() or "[]")
    except ValueError:
        return None
    return [(r.get("from"), r.get("text") or "", r.get("thread"))
            for r in records if isinstance(r, dict) and (r.get("text") or "").strip()]


def route(message, threads):
    """Who a human's Slack message should WAKE.

    Three cases, and they exist because a phone gives a human exactly one
    structured gesture — replying in a thread — plus whatever they type.

      thread reply  -> wake only the agent whose message started that thread.
                       That agent asked; this is its answer; nobody else is
                       owed an interrupt for it.
      top level     -> wake NOBODY. A human thinking out loud in the channel
                       should not pull every agent on the machine off its work.
                       They still see it when they are next working.
      @here/@channel-> wake everyone. Both spellings mean the same thing here:
                       an agent in the room is always "here", so the human
                       distinction between present and merely-a-member does not
                       exist on this side.

    @here WINS over the thread rule. It is the one explicit thing the human
    typed, and explicit beats inferred — a person who writes @here inside a
    thread means everyone, not "only the agent I happen to be replying to".

    This is the ONLY place text is parsed for addressing. Everywhere else it is
    a flag, because an agent pasting a log line containing @here would
    otherwise wake every agent on the machine. A human has no flags to pass,
    so in-band is the only option HERE and nowhere else.
    """
    text = message.get("text") or ""
    # "WE ARE DONE HERE" HAD TO BE SAYABLE. A human's message became a debt
    # even when it was literally "No response needed" — and the stop-gate then
    # refused to let the turn end until the agent replied to it, in a thread
    # the human had finished with. So the mechanism built to stop an agent
    # going silent was compelling answers nobody asked for.
    #
    # `leave` ends the AGENT's side; there was nothing for the other end. This
    # is that, as a convention the bridge recognises, and it beats @here
    # because it is the more explicit statement of intent: "everyone see this"
    # and "nobody reply" are not in conflict.
    if NO_REPLY_NEEDED.search(text):
        return ["--to-none"]
    if EVERYONE.search(text):
        return ["--to-all"]
    parent = message.get("thread_ts")
    if parent and parent != message.get("ts"):
        sender = threads.get(parent)
        if sender:
            return ["--to", sender]
        # A thread whose root we no longer remember. Waking everyone would
        # spam; waking nobody at least reaches them passively, and is what a
        # top-level message does anyway.
        return ["--to-none"]
    return ["--to-none"]


def say(room, identity, text, addressing=None, thread=None):
    """Post as the human. Via --file, so shell metacharacters in a Slack
    message cannot be eaten before the CLI sees them.

    STAMPS THE THREAD IT CAME FROM. That is what lets an agent answer the
    conversation it is actually in: it reads the `thread` field back out of
    `read --json` and hands it to `say --thread`. Before this the bridge kept
    its own map of who-was-asked-where and guessed, which went wrong the moment
    two questions were outstanding.
    """
    path = os.path.join(STATE, "slack-inbound.txt")
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            f.write(text)
        command = [sys.executable, CLI, "say", room, "--file", path,
                   "--as", identity] + list(addressing or [])
        if thread:
            command += ["--thread", thread]
        subprocess.run(command, capture_output=True, text=True, timeout=15)
        return True
    except Exception:
        return False


def is_from_a_human(message):
    """Skip anything this bridge posted.

    Slack applies no self-filter, so the bridge's own relays would come back
    and be relayed into llm_chat, which would deliver them to the agents, which
    changes nothing — but every one is a message, a wake, and a cap increment,
    forever. Bot posts carry `bot_id`; a person's do not.
    """
    if message.get("bot_id") or message.get("subtype") == "bot_message":
        return False
    return bool(message.get("text"))


def pump_out(config, slack):
    """llm_chat -> Slack. Returns how many were relayed.

    A read that FAILED is reported and returns 0. Reported on the transition
    only: this runs every poll_sec, so printing on each failure would bury the
    first occurrence — the one that says when it started — under hundreds of
    identical lines, and a log nobody can read is the same as no log.
    """
    lines = waiting_for_human(config["room"], config["identity"])
    if lines is None:
        if not _READ_STATE["broken"]:
            _READ_STATE["broken"] = True
            print("CANNOT READ #%s as '%s' — the agent->Slack direction is "
                  "DEAD.\n  Nothing an agent says will reach you. Most often "
                  "that identity never\n  joined the room:\n"
                  "    llm_chat join %s --as %s"
                  % (config["room"], config["identity"],
                     config["room"], config["identity"]), file=sys.stderr)
        return 0
    if _READ_STATE["broken"]:
        _READ_STATE["broken"] = False
        print("reading #%s again" % config["room"], file=sys.stderr)
    asked = read_asked()
    for sender, line, named in lines:
        # THE AGENT'S OWN ANSWER FIRST. `say --thread` is the agent saying
        # which conversation its reply belongs to, and it knows — it read the
        # thread off the message it is answering. Nothing here has to infer it.
        #
        # The inferred parent stays as the fallback for an agent that said
        # nothing, which is every agent written before --thread existed. It
        # guesses only when unambiguous; see parent_for.
        parent = named or (parent_for(asked, sender) if sender else None)
        try:
            posted = slack.post(("*%s*: %s" % (sender, line)) if sender
                                else line, thread_ts=parent)
            # A REFUSAL IS NOT A DELIVERY. `chat.postMessage` answers a bad
            # thread_ts with {"ok": false, "error": "thread_not_found"} — not
            # an exception — and this used to read `ok` only to decide whether
            # to record a root. So a refused post fell through to `relayed`,
            # the message was already off llm_chat's cursor, and the sender was
            # told it was sent.
            #
            # That is the artifact the reporter objected to and they were
            # right: a message asserting it was threaded, absent from Slack
            # entirely, with `say` reporting success. Loud, and it names the
            # thread, because "which thread" is the only fact that makes it
            # actionable.
            if isinstance(posted, dict) and not posted.get("ok"):
                print("REFUSED by Slack (%s)%s — NOT delivered:\n  %s"
                      % (posted.get("error") or "no reason given",
                         " thread=%s" % parent if parent else "",
                         line), file=sys.stderr)
                continue
            if isinstance(posted, dict) and posted.get("ok") and not parent:
                remember_thread(posted.get("ts"), sender)
        except Exception as problem:
            # The message is already consumed from llm_chat's cursor at this
            # point, so a Slack failure loses it. Say so loudly rather than
            # dropping it silently — silence from a bridge is indistinguishable
            # from nobody having said anything.
            print("LOST relaying to Slack: %s\n  %s" % (problem, line),
                  file=sys.stderr)
    # Persisted once per pump rather than per message: the debts are only
    # cleared above, so a crash mid-loop re-answers into the same thread,
    # which is the harmless direction.
    write_asked(asked)
    return len(lines)


def pump_in(config, slack):
    """Slack -> llm_chat. Returns how many were relayed."""
    try:
        payload = slack.history(oldest=read_cursor())
    except Exception:
        return 0
    if not payload.get("ok"):
        print("Slack refused conversations.history: %s"
              % payload.get("error"), file=sys.stderr)
        return 0
    messages = sorted(payload.get("messages") or [],
                      key=lambda m: float(m.get("ts", 0)))
    threads = read_threads()
    relayed = 0
    for message in messages:
        ts = message.get("ts")
        if is_from_a_human(message):
            addressing = route(message, threads)
            # A top-level message stamps its OWN ts, so an agent answering it
            # opens a thread ON it rather than replying beside it in the
            # channel. That is the second thing a human wants and there was no
            # way to express it.
            if say(config["room"], config["identity"], message["text"],
                   addressing, message.get("thread_ts") or message.get("ts")):
                note_question(message, addressing)
                relayed += 1
        if ts:
            write_cursor(ts)
    return relayed + pump_threads(config, slack, messages, threads)


def pump_threads(config, slack, messages, threads):
    """Relay thread REPLIES, which history never returns. Count relayed.

    ENUMERATED FROM THE THREAD MAP, NOT FROM THE HISTORY WINDOW. The first
    version of this walked the messages `history` returned, which is the set
    of parents newer than the cursor — and the cursor advances on every
    top-level message. So one unrelated post permanently deafened every
    existing thread: its parent fell out of the window, its `reply_count` was
    never re-read, and its replies were never fetched again.

    That was worse than no threading, because it worked for the newest thread
    until the next message arrived, which reads as intermittent rather than
    absent. Same shape as the bug it was fixing — a correct answer to a
    narrower question than the one being asked.

    The thread map already holds every parent this bridge has relayed, which
    is exactly the set whose replies matter. `history` is still the right
    source for top-level messages, and its `reply_count` is still used as a
    FREE hint when the parent happens to be in-window — but it cannot be the
    enumerator.

    BOUNDED THREE WAYS, because the map is not: only parents from the last
    THREAD_WATCH_SEC, only the newest MAX_WATCHED_THREADS of those, and each
    re-checked at most every RECHECK_SEC. Without those a long-lived channel
    would grow an unbounded per-poll cost, and an out-of-window parent cannot
    be skipped for free — there is no way to learn it grew except by asking.

    The parent itself comes back inside its own replies and is skipped by ts;
    bot messages are skipped by `is_from_a_human`, the same loop guard the
    top-level path relies on.
    """
    seen = read_reply_state()
    hints = {m.get("ts"): m.get("reply_count") or 0
             for m in messages if m.get("ts")}
    relayed = 0
    changed = False
    for ts in watched_parents(threads, seen, hints):
        count = hints.get(ts)
        try:
            payload = slack.replies(ts)
        except Exception as problem:
            print("could not read thread %s: %s" % (ts, problem),
                  file=sys.stderr)
            continue
        if not payload.get("ok"):
            print("Slack refused conversations.replies: %s"
                  % payload.get("error"), file=sys.stderr)
            continue
        last = seen.get(ts, {}).get("seen_ts") or ts
        newest = last
        for reply in sorted(payload.get("messages") or [],
                            key=lambda m: float(m.get("ts", 0))):
            at = reply.get("ts")
            if not at or at == ts or float(at) <= float(last):
                continue
            if is_from_a_human(reply):
                # `thread_ts` is what `route` keys on, and a reply carries it —
                # but only messages the human ALSO chose to broadcast appear in
                # history, so this is where the routing finally gets its input.
                addressing = route(reply, threads)
                if say(config["room"], config["identity"], reply["text"],
                       addressing, ts):
                    note_question(reply, addressing)
                    relayed += 1
            if float(at) > float(newest):
                newest = at
        # `count` is None for an out-of-window parent — there was no hint to
        # read. Record what the fetch itself showed, so the free in-window
        # skip works again the moment this parent comes back into the window.
        replied = len([m for m in (payload.get("messages") or [])
                       if m.get("ts") != ts])
        seen[ts] = {"count": count if count is not None else replied,
                    "seen_ts": newest, "checked_at": now()}
        changed = True
    if changed:
        write_reply_state(seen)
    return relayed


def check(config):
    if config is None:
        print("no config — create %s" % CONFIG)
        print('  {"room": "<llm_chat room>", "identity": "<you>",')
        print('   "slack": {"bot_token": "xoxb-...", "channel": "C..."}}')
        return 1
    if config.get("missing"):
        print("config incomplete: missing %s" % ", ".join(config["missing"]))
        return 1
    slack = Slack(config["slack"]["bot_token"], config["slack"]["channel"],
                  config["slack"].get("api_base", "https://slack.com/api"))
    try:
        payload = slack.history()
    except Exception as problem:
        print("cannot reach Slack: %s" % problem)
        return 1
    if not payload.get("ok"):
        error = payload.get("error")
        print("Slack refused: %s" % error)
        if error == "missing_scope":
            print("  add the history scope matching the channel TYPE, then "
                  "REINSTALL the app —\n  a token keeps its old scopes until "
                  "you do. channels:history for public,\n  groups:history for "
                  "private, im:history for a DM.")
        elif error == "not_in_channel":
            print("  invite the bot to the channel; membership is separate "
                  "from scope.")
        return 1
    print("Slack reachable, bot is in the channel, history readable")

    # THE HALF THIS COMMAND USED TO SKIP. It validated Slack and then printed
    # "bridging <room> as <identity>" without ever asking whether that identity
    # can read that room — so the one command whose entire purpose is "is the
    # wiring live?" passed with half the wiring dead. A fresh bridge ran for a
    # whole session that way: Slack perfect, llm_chat unreadable because the
    # identity had never joined, and nothing said so.
    #
    # It is the same subprocess call the loop makes, so testing it costs one
    # invocation and removes the only remaining way for --check to lie.
    if waiting_for_human(config["room"], config["identity"]) is None:
        print("but CANNOT READ #%s as '%s' — the agent->Slack direction is dead."
              % (config["room"], config["identity"]))
        print("  Nothing an agent says would reach you. Most often that "
              "identity has never\n  joined the room:")
        print("    llm_chat join %s --as %s"
              % (config["room"], config["identity"]))
        return 1
    print("llm_chat readable as '%s'" % config["identity"])
    print("bridging #%s as '%s'" % (config["room"], config["identity"]))
    return 0


def room_is_gone(config):
    """True only when the room is provably absent, never when we cannot tell.

    Asks the CLI for the machine-readable room list, which is the same source
    the waker uses. Three states, and only one of them stops the bridge:

      the room is listed          -> keep going
      the CLI failed              -> keep going, and say so
      it answered without the room -> gone

    A failed lookup MUST NOT stop the bridge. The server being briefly
    unreachable is the most common thing that happens to it, and treating
    "cannot tell" as "deleted" would tear down the human's escalation path —
    plus its cursor — over a restart. That is the check-fails-safe trap from
    #learnings pointed the wrong way: here the safe answer is to keep running.
    """
    done = subprocess.run(
        [sys.executable, CLI, "channels", "--json", "--all"],
        capture_output=True, text=True)
    if done.returncode != 0:
        print("  (could not list rooms: %s)"
              % (done.stderr or done.stdout).strip()[:120])
        return False
    try:
        listing = json.loads(done.stdout or "[]")
    except ValueError:
        return False
    return not any(room.get("name") == config["room"] for room in listing)


def main() -> int:
    config = load_config()
    if "--check" in sys.argv:
        return check(config)
    if config is None or config.get("missing"):
        return check(config)

    slack = Slack(config["slack"]["bot_token"], config["slack"]["channel"],
                  config["slack"].get("api_base", "https://slack.com/api"))
    poll = int(config["slack"].get("poll_sec") or DEFAULT_POLL_SEC)
    print("bridging #%s as '%s' every %ds — Ctrl-C to stop"
          % (config["room"], config["identity"], poll))
    while True:
        if room_is_gone(config):
            # STOP RATHER THAN KEEP POLLING. `llm_chat delete` destroys the
            # room from another process entirely, and this one would otherwise
            # go on relaying an empty room to Slack forever — a bridge whose
            # llm_chat half has no members, posting nothing and reading
            # nothing, but still holding a token and still costing a Slack
            # request every poll.
            #
            # Its own state goes too. The cursor and thread map are keyed to a
            # room that no longer exists, so leaving them means a NEW room of
            # the same name silently inherits another conversation's read
            # position and thread parents.
            for path in (CURSOR, THREADS, REPLIES):
                try:
                    os.remove(path)
                except OSError:
                    pass
            print("room #%s no longer exists — bridge stopping, state cleared"
                  % config["room"])
            return 0
        out = pump_out(config, slack)
        back = pump_in(config, slack)
        if out or back:
            print("  -> Slack %d, <- llm_chat %d" % (out, back))
        time.sleep(poll)


if __name__ == "__main__":
    sys.exit(main())
