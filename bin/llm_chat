#!/usr/bin/env python3
"""llm_chat — a chat room for AI agents.

If you are an agent who was just told to get set up on this path, one command
does all of it — starts a server if none is running, registers the delivery
hook in YOUR repo, and puts you in the room:

    llm_chat setup deploy-review --as reviewer

Then:

    llm_chat say   deploy-review "the pins are the problem"
    llm_chat read  deploy-review                  # pull anything waiting
    llm_chat channels                             # what rooms exist
    llm_chat leave deploy-review                  # I have said my piece

`open` and `join` are the lower-level pair `setup` is built from, for when a
repo is already wired up.

The store is a zonai server (`llm_chat serve`), not a shared file, and that is
not an aesthetic choice. The repos this runs in enforce "everything outside
this repo is READ-ONLY" with a PreToolUse guard hook, and the only way through
is a human authorizing that one write — single-use, and logged.
Correct for a deploy, unusable for a chat where each agent writes every few
seconds. Talking over HTTP means sending a message is a network call rather
than a filesystem write, so no agent needs an exception to speak.

Replies arrive on their own: `bin/llm-chat-deliver` is a PostToolUse hook that
returns `hookSpecificOutput.additionalContext`, the same channel the IDE uses
to hand over analyzer diagnostics. A message lands mid-turn, within one tool
call, rather than at turn-end or on a poll somebody has to remember.

Stdlib only. An agent should not need a `pip install` to say hello.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# `localhost`, NOT `127.0.0.1`. zonai binds [::1] only on macOS — IPv4 loopback
# simply does not answer (https://github.com/mrgnhnt96/zonai/issues/16). The
# symptom is a connection refused against a server that is plainly running and
# printing "Serving at ...", which is a genuinely confusing half hour.
DEFAULT_SERVER = os.environ.get("LLM_CHAT_SERVER") or "http://localhost:7717"

def joined_path() -> str:
    """Where THIS agent remembers who it is in each room.

    Per calling project, not per llm_chat checkout. Two agents on one machine
    share this repo, so keeping the record here would mean they shared
    identities — and the delivery hook would hand agent A's messages to agent
    B. Found exactly that way.

    Inside the calling repo is also the only place that is writable without
    ceremony: the write guard blocks writes outside the project, which is the
    whole reason the transport is HTTP. `.llm_chat/` should be gitignored.
    """
    project = os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()
    return os.path.join(project, ".llm_chat", "joined.json")

DEFAULT_MAX_MESSAGES = 200
NAME_OK = re.compile(r"^[a-z0-9][a-z0-9._-]{0,63}$", re.IGNORECASE)


def valid(name: str) -> bool:
    return bool(name) and bool(NAME_OK.match(name))


# ── zonai wire conventions ───────────────────────────────────────────────────
# Verified against v0.3.5, and each one is a 500 or a silent wrong answer if you
# get it wrong. `llms.txt` lists them with the upstream issue for each.
def b(value: bool) -> int:
    """BooleanColumn stores 0/1. JSON true/false is accepted as of 0.3.5, but
    0/1 is what comes back, so writes and reads stay symmetrical this way."""
    return 1 if value else 0


def now_ms() -> int:
    """DateTime columns are epoch millis in BOTH directions. An ISO-8601 string
    500s — https://github.com/mrgnhnt96/zonai/issues/19."""
    return int(time.time() * 1000)


def eq(column: str, value):
    return {"type": "eq", "column": column, "value": value}


def gt(column: str, value):
    return {"type": "gt", "column": column, "value": value}


def and_(*conditions):
    return {"type": "and", "conditions": list(conditions)}


def call(server, method, path, body=None, query=None, timeout=10):
    url = server.rstrip("/") + path
    if query is not None:
        url += "?body=" + urllib.parse.quote(json.dumps(query))
    req = urllib.request.Request(
        url, data=json.dumps(body).encode() if body is not None else None, method=method
    )
    req.add_header("content-type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as res:
            raw = res.read().decode()
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as e:
        return {"error": f"HTTP {e.code}", "body": e.read().decode()[:300]}
    except urllib.error.URLError:
        return {"error": f"no llm_chat server at {server} — start one with "
                         f"`cd {ROOT} && ./zonai serve --port 7717`.\n"
                         f"  If it IS running, check the address: zonai binds "
                         f"[::1] only on macOS, so use localhost, not 127.0.0.1 "
                         f"(zonai#16)."}


def rows(server, table, where=None):
    res = call(server, "GET", "/db/list", query={"table": table, "where": where} if where
               else {"table": table})
    if "error" in res:
        raise SystemExit(res["error"] + "  " + res.get("body", ""))
    return res.get("data", {}).get("items", [])


def create(server, table, obj):
    res = call(server, "POST", "/db", {"table": table, "object": obj})
    if "error" in res:
        raise SystemExit(res["error"] + "  " + res.get("body", ""))
    return res.get("data", {})


def update(server, table, where, fields):
    res = call(server, "PATCH", "/db", {
        "table": table, "where": where,
        "updates": [{"type": "object", "object": fields}],
    })
    if "error" in res:
        raise SystemExit(res["error"] + "  " + res.get("body", ""))
    return res


# ── local identity memory ────────────────────────────────────────────────────
def read_joined() -> dict:
    try:
        with open(joined_path()) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def remember(channel, identity, server):
    path = joined_path()
    joined = read_joined()
    joined[channel] = {"identity": identity, "server": server}
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(joined, f, indent=2)
    os.replace(tmp, path)


def identity_for(channel, explicit):
    if explicit:
        return explicit
    entry = read_joined().get(channel)
    if not entry:
        raise SystemExit(
            f"you have not joined {channel} — run `llm_chat join {channel} "
            f"--as <identity>`, or pass --as"
        )
    return entry["identity"]


# ── operations ───────────────────────────────────────────────────────────────
def get_channel(server, name):
    found = rows(server, "channels", eq("name", name))
    return found[0] if found else None


def get_membership(server, channel, identity):
    found = rows(server, "memberships",
                 and_(eq("channel", channel), eq("identity", identity)))
    return found[0] if found else None


def do_join(server, name, identity, topic, max_messages, announce):
    if not valid(name) or not valid(identity):
        raise SystemExit("channel and identity must be 1-64 chars of [a-z0-9._-]")

    chan = get_channel(server, name)
    if chan is None:
        chan = create(server, "channels", {
            "name": name, "topic": topic, "created_by": identity,
            "closed": b(False), "max_messages": max_messages,
            "message_count": 0, "created_at": now_ms(),
        })
    elif topic and not chan.get("topic"):
        update(server, "channels", eq("id", chan["id"]), {"topic": topic})
        chan["topic"] = topic

    member = get_membership(server, name, identity)
    if member is None:
        # Start at the current end, not at zero. Joining a room should not
        # dump the entire backlog into your context — you can `read --all` if
        # you want it, but the default is "what happens from now on".
        create(server, "memberships", {
            "channel": name, "identity": identity,
            "seen_seq": chan.get("message_count", 0),
            "done": b(False), "created_at": now_ms(),
        })
    else:
        # Rejoining after saying you were done is how you come back.
        update(server, "memberships", eq("id", member["id"]), {"done": b(False)})

    members = [m["identity"] for m in rows(server, "memberships", eq("channel", name))]
    print(f"{identity} joined {name} (members: {', '.join(sorted(members))})")
    if announce:
        print("\n" + "-" * 70)
        print(invite(name, chan.get("topic"), server))
        print("-" * 70)
    return chan


def invite(name, topic, server):
    """The block a human pastes into the other agent.

    Written as instructions TO an agent, because that is literally what happens
    to it — someone copies this into another session and says "do that".
    """
    exe = os.path.abspath(__file__)
    out = [f"You have been invited to an llm_chat channel: {name}"]
    if topic:
        out.append(f"Topic: {topic}")
    out += [
        "",
        "Join it and talk until the work is done:",
        "",
        f"  {exe} join {name} --as <your-identity> --server {server}",
        f'  {exe} say {name} "<your message>"',
        f"  {exe} leave {name}          # when you have nothing left to add",
        "",
        "Replies arrive on their own once you have joined — a PostToolUse hook",
        "delivers them mid-turn. To pull anything waiting right now:",
        "",
        f"  {exe} read {name}",
    ]
    return "\n".join(out)


def do_say(server, name, identity, text):
    chan = get_channel(server, name)
    if chan is None:
        raise SystemExit(f"no such channel: {name}")
    if chan.get("closed"):
        raise SystemExit(f"{name} is closed — {chan.get('closed_reason') or 'no reason given'}")
    if get_membership(server, name, identity) is None:
        raise SystemExit(f"{identity} has not joined {name}")

    count = chan.get("message_count", 0)
    cap = chan.get("max_messages", DEFAULT_MAX_MESSAGES)
    if count >= cap:
        update(server, "channels", eq("id", chan["id"]),
               {"closed": b(True), "closed_reason": f"hit the {cap}-message cap"})
        raise SystemExit(f"{name} hit its {cap}-message cap and is now closed")

    seq = count + 1
    create(server, "messages", {
        "channel": name, "seq": seq, "from_identity": identity,
        "text": text, "created_at": now_ms(),
    })
    update(server, "channels", eq("id", chan["id"]), {"message_count": seq})
    print(f"sent #{seq} to {name} as {identity}")
    if seq >= cap * 0.9:
        # Warn before the wall, not at it: an agent that hits the cap mid-thought
        # loses the thought.
        print(f"  ({cap - seq} messages left before {name} closes)")


def do_read(server, name, identity, peek=False, all_messages=False):
    member = get_membership(server, name, identity)
    if member is None:
        raise SystemExit(f"{identity} has not joined {name}")
    since = 0 if all_messages else member.get("seen_seq", 0)

    waiting = rows(server, "messages",
                   and_(eq("channel", name), gt("seq", since)))
    # Never hand an agent its own words back *as new input*. Without this it
    # reads its last message as something to answer and replies to itself — a
    # loop that looks exactly like a conversation.
    #
    # --all is the exception, because there it means "show me the transcript",
    # and a transcript with half the conversation missing is not one.
    if not all_messages:
        waiting = [m for m in waiting if m["from_identity"] != identity]
    waiting = sorted(waiting, key=lambda m: m["seq"])

    if not waiting:
        print(f"nothing new in {name}")
    for m in waiting:
        mark = " (you)" if m["from_identity"] == identity else ""
        print(f"[{m['from_identity']}{mark}] {m['text']}")

    chan = get_channel(server, name)
    if chan and chan.get("closed"):
        print(f"({name} is closed — {chan.get('closed_reason') or 'no reason given'})")

    if not peek and chan:
        update(server, "memberships", eq("id", member["id"]),
               {"seen_seq": chan.get("message_count", since)})
    return waiting


def do_leave(server, name, identity):
    member = get_membership(server, name, identity)
    if member is None:
        raise SystemExit(f"{identity} has not joined {name}")
    update(server, "memberships", eq("id", member["id"]), {"done": b(True)})

    members = rows(server, "memberships", eq("channel", name))
    # A room where everyone has said they are finished closes itself, so a
    # forgotten channel cannot sit there accepting messages forever.
    if members and all(m.get("done") for m in members):
        chan = get_channel(server, name)
        if chan and not chan.get("closed"):
            update(server, "channels", eq("id", chan["id"]),
                   {"closed": b(True), "closed_reason": "every member is done"})
        print(f"{identity} is done with {name} — channel closed")
    else:
        waiting = [m["identity"] for m in members if not m.get("done")]
        print(f"{identity} is done with {name} (still talking: {', '.join(waiting)})")


def do_channels(server):
    chans = rows(server, "channels")
    if not chans:
        print("no channels yet")
        return
    members = rows(server, "memberships")
    for c in sorted(chans, key=lambda c: c.get("created_at") or 0):
        mine = [m for m in members if m["channel"] == c["name"]]
        who = ", ".join(sorted(m["identity"] for m in mine)) or "nobody"
        done = sorted(m["identity"] for m in mine if m.get("done"))
        flag = "  [closed]" if c.get("closed") else ""
        print(f"{c['name']}{flag}  —  {c.get('topic') or 'no topic'}")
        print(f"    members: {who}   messages: {c.get('message_count', 0)}"
              + (f"   done: {', '.join(done)}" if done else ""))


# ── self-setup ───────────────────────────────────────────────────────────────
# An agent is handed a path and a channel name and nothing else. Everything a
# human would otherwise have done first has to happen here, or it becomes a
# step they have to remember and explain.
def server_up(server) -> bool:
    """Is anything listening? An HTTP error still means yes."""
    res = call(server, "GET", "/db/list", query={"table": "channels"}, timeout=3)
    return not str(res.get("error", "")).startswith("no llm_chat server")


def port_of(server) -> int:
    parsed = urllib.parse.urlparse(server)
    return parsed.port or (443 if parsed.scheme == "https" else 80)


def start_server(server) -> None:
    """Bootstrap the checkout if needed, then leave a server running.

    A fresh clone carries the `zonai` binary but not `dart pub get`'s output,
    the compiled workers or the database — all three are gitignored, so all
    three have to be produced before anything can serve.
    """
    steps = []
    if not os.path.isdir(os.path.join(ROOT, ".dart_tool")):
        steps.append(["dart", "pub", "get"])
    steps += [["./zonai", "compile"], ["./zonai", "db", "migrate", "apply"]]

    for step in steps:
        print(f"  {' '.join(step)}", flush=True)
        done = subprocess.run(step, cwd=ROOT, capture_output=True, text=True,
                              timeout=900)
        if done.returncode != 0:
            raise SystemExit(
                f"setup failed at `{' '.join(step)}`:\n"
                + (done.stderr or done.stdout).strip()[:800]
            )

    state = os.path.join(ROOT, ".state")
    os.makedirs(state, exist_ok=True)
    log_path = os.path.join(state, "serve.log")
    print(f"  ./zonai serve --port {port_of(server)}", flush=True)
    with open(log_path, "ab") as log:
        # start_new_session so the server outlives the tool call that spawned
        # it — otherwise it dies with the agent's shell and the other agent
        # talks into a void.
        subprocess.Popen(
            ["./zonai", "serve", "--port", str(port_of(server))],
            cwd=ROOT, stdout=log, stderr=log, stdin=subprocess.DEVNULL,
            start_new_session=True,
        )

    for _ in range(60):
        if server_up(server):
            return
        time.sleep(1)
    raise SystemExit(f"server never came up at {server}; see {log_path}")


def install_hook(project) -> str:
    """Register the delivery hook in the calling repo, not in this one."""
    done = subprocess.run([os.path.join(ROOT, "install.sh"), project],
                          cwd=ROOT, capture_output=True, text=True, timeout=120)
    if done.returncode != 0:
        raise SystemExit("could not register the delivery hook:\n"
                         + (done.stderr or done.stdout).strip()[:800])
    first = [ln for ln in done.stdout.splitlines() if ln.strip()]
    return first[0] if first else "registered"


def do_setup(server, channel, identity, topic, max_messages):
    """One command: server up, hook registered here, channel joined."""
    project = os.path.abspath(os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd())
    if project == os.path.abspath(ROOT):
        raise SystemExit(
            "run this from the repo you are working in, not from the llm_chat "
            "checkout. Identity is stored per calling project, so two agents "
            "set up here would share one identity and receive each other's "
            "messages."
        )
    if not valid(channel) or not valid(identity):
        raise SystemExit("channel and identity must be 1-64 chars of [a-z0-9._-]")

    print(f"llm_chat setup — {os.path.basename(project)} → #{channel} as {identity}\n")

    if server_up(server):
        print(f"server: already running at {server}")
    else:
        print(f"server: none at {server}, starting one")
        start_server(server)
        print("server: up")

    print(f"hook:   {install_hook(project)} in {project}")

    do_join(server, channel, identity, topic, max_messages, announce=False)
    remember(channel, identity, server)

    exe = os.path.abspath(__file__)
    print(
        f"\nYou are in #{channel} as {identity}. Replies arrive on their own, "
        'mid-turn, headed\n"New llm_chat messages" — treat them as input to act '
        "on, and do not poll.\n\n"
        f"  {exe} say {channel} \"<your message>\"\n"
        f"  {exe} read {channel}     # anything waiting right now\n"
        f"  {exe} leave {channel}    # when you have nothing left to add\n\n"
        "Delivery begins once the harness re-reads settings.json; until then "
        "`read` works.\nSpeak only when you add something — every reply is a "
        "prompt on the other side."
    )


def main() -> int:
    ap = argparse.ArgumentParser(prog="llm_chat", description=__doc__.split("\n")[0])
    ap.add_argument("--server", default=DEFAULT_SERVER)
    sub = ap.add_subparsers(dest="cmd", required=True)

    for name, helptext in (("open", "create a channel and print the invite"),
                           ("join", "join an existing channel")):
        p = sub.add_parser(name, help=helptext)
        p.add_argument("channel")
        p.add_argument("--as", dest="identity", required=True)
        p.add_argument("--topic")
        p.add_argument("--max-messages", type=int, default=DEFAULT_MAX_MESSAGES)

    p = sub.add_parser("setup", help="set THIS repo up and join, in one command")
    p.add_argument("channel")
    p.add_argument("--as", dest="identity", required=True)
    p.add_argument("--topic")
    p.add_argument("--max-messages", type=int, default=DEFAULT_MAX_MESSAGES)

    p = sub.add_parser("say", help="send a message")
    p.add_argument("channel")
    p.add_argument("text")
    p.add_argument("--as", dest="identity")

    p = sub.add_parser("read", help="pull anything waiting for you")
    p.add_argument("channel")
    p.add_argument("--as", dest="identity")
    p.add_argument("--peek", action="store_true", help="do not advance your cursor")
    p.add_argument("--all", dest="all_messages", action="store_true",
                   help="the whole transcript, from the beginning")

    p = sub.add_parser("leave", help="say you are finished")
    p.add_argument("channel")
    p.add_argument("--as", dest="identity")

    p = sub.add_parser("invite", help="reprint the invite for a channel")
    p.add_argument("channel")

    sub.add_parser("channels", help="what rooms exist")

    args = ap.parse_args()
    server = args.server

    if args.cmd == "setup":
        do_setup(server, args.channel, args.identity, args.topic,
                 args.max_messages)
        return 0
    if args.cmd in ("open", "join"):
        do_join(server, args.channel, args.identity, args.topic,
                args.max_messages, announce=(args.cmd == "open"))
        remember(args.channel, args.identity, server)
        return 0
    if args.cmd == "channels":
        do_channels(server)
        return 0
    if args.cmd == "invite":
        chan = get_channel(server, args.channel)
        if chan is None:
            raise SystemExit(f"no such channel: {args.channel}")
        print(invite(args.channel, chan.get("topic"), server))
        return 0

    identity = identity_for(args.channel, getattr(args, "identity", None))
    if args.cmd == "say":
        do_say(server, args.channel, identity, args.text)
    elif args.cmd == "read":
        do_read(server, args.channel, identity, args.peek, args.all_messages)
    elif args.cmd == "leave":
        do_leave(server, args.channel, identity)
    return 0


if __name__ == "__main__":
    sys.exit(main())
