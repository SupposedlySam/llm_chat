#!/usr/bin/env python3
"""Stop hook: WAKE an idle session when a reply arrives.

`bin/llm-chat-deliver` is a PostToolUse hook, so it only fires while the agent
is working. The moment a turn ends the agent goes quiet and nothing fires at
all — so a reply sent one second later waits until the agent happens to run
another tool, which for an idle agent is never. Two agents "talking until the
work is done" therefore stall at every turn boundary, and a human has to prod
one of them. That is the gap this closes.

Claude Code exposes no inbound IPC, but a **Stop** hook registered with
`asyncRewake: true` blocks in the BACKGROUND after the turn ends, and when it
prints to stderr and exits 2 the harness turns that into a model wake-up **in
the same session**, with the stderr text as the message. So: poll while idle,
and wake on arrival.

Costs one loopback request per poll per idle joined project, and only while
listening — it exits silently the moment the project is in no rooms, before any
network call. It stops early when every joined room is closed or left, so a
finished conversation does not leave a poller running.

Delivery goes through `llm_chat read`, the same path the PostToolUse hook uses,
so the two share one server-side cursor and one lock: whichever reaches a
message first delivers it, exactly once.

If the harness ever stops honouring `asyncRewake`, this fails SILENT — the poll
still runs and the wake simply never lands. Nothing here would notice. The
symptom is replies that only arrive once the agent does something else.
"""
import hashlib
import json
import os
import select
import signal
import socket
import subprocess
import sys
import tempfile
import time

HERE = os.path.dirname(os.path.abspath(__file__))
CLI = os.path.join(HERE, "llm_chat")

# MIRRORED from bin/llm_chat, and it must stay the same expression: it is the
# fallback for the doorbell namespace, so a difference here would put the
# ringer and the listener in two directories that both look correct.
DEFAULT_SERVER = os.environ.get("LLM_CHAT_SERVER") or "http://localhost:7717"

def _project_dir():
    """Root of the calling repo — never the raw cwd.

    Mirrors project_dir() in bin/llm_chat; kept inline because this runs on
    every tool call and cannot afford a subprocess to ask. `.llm_chat/` lives at
    a project's root, so resolving to a subdirectory splits one project into
    two identities and this hook would then read the wrong one.
    """
    env = os.environ.get("CLAUDE_PROJECT_DIR")
    if env:
        return os.path.abspath(env)
    here = probe = os.path.abspath(os.getcwd())
    while True:
        if (os.path.isdir(os.path.join(probe, ".llm_chat"))
                or os.path.isdir(os.path.join(probe, ".git"))):
            return probe
        parent = os.path.dirname(probe)
        if parent == probe:
            return here
        probe = parent


PROJECT = _project_dir()
STATE = os.path.join(PROJECT, ".llm_chat")

# SESSION-SCOPED, mirroring bin/llm_chat. The waker is spawned by this
# session's own hook, so it inherits the id — and it must resolve to the same
# rooms the CLI writes, or it would bind doorbells for a set of rooms nobody
# is joining and stay silent while messages arrive.
_SID = (os.environ.get("CLAUDE_CODE_SESSION_ID") or "").strip()
SESSION_STATE = os.path.join(STATE, "sessions", _SID) if _SID else STATE
JOINED = (os.path.join(SESSION_STATE, "joined.json")
          if _SID and os.path.isfile(os.path.join(SESSION_STATE,
                                                  "joined.json"))
          else os.path.join(STATE, "joined.json"))
PID_PATH = os.path.join(STATE, "wake.pid")
EXIT_PATH = os.path.join(STATE, "wake.exit")
# The LIVE waker, kept apart from the exit history on purpose. `reason:
# running` used to be written into wake.exit, where it read as an exit record
# and — worse — destroyed the real one. See record_exit.
ALIVE_PATH = os.path.join(STATE, "wake.alive")

# How many exit records to keep. The failure this is sized for is a waker
# stopping and its replacement starting immediately, so the minimum useful
# number is two. Four covers a VSCode window reload, which starts more than one
# on this host, and is still small enough to read at a glance.
KEEP_EXITS = 4
REWAKE_PATH = os.path.join(STATE, "wake.rewake")
LANDED_PATH = os.path.join(STATE, "wake.landed")

# How soon after an exit-2 a new waker must appear for the turn to be
# attributable to it. Generous enough to survive a slow host, short enough
# that unrelated human activity is unlikely to be mistaken for a landing —
# and the cost of guessing wrong in that direction is the false green this
# whole marker exists to remove, so it errs short.
REWAKE_GRACE = 90

# No longer a poll interval — nothing is polled. This is how long the waker
# blocks before waking to recheck whether it has been superseded or orphaned,
# both of which are local file reads. Long on purpose: a message does not wait
# for it, the doorbell does that.
HEARTBEAT_SEC_DEFAULT = 300

# There is NO listen budget. If you are in a room you hear every reply, full
# stop — a timer here meant an idle agent went silently deaf at a moment
# unrelated to anything, and nothing re-arms it while it waits, because only a
# turn-end or a session start does and neither happens to an agent that is
# waiting. The budget was standing in for "has this session gone away?", which
# is answerable directly: see orphaned().
#
# The parent process is the Claude Code extension. When it dies this process is
# reparented (pid 1), which is a precise, free liveness signal — no token to
# refresh and nothing to keep in sync.
PARENT = os.getppid()
HEARTBEAT_SEC = int(os.environ.get("LLM_CHAT_HEARTBEAT_SEC")
                    or HEARTBEAT_SEC_DEFAULT)


def own_tmp(path):
    """A scratch path no other process will write. See the CLI's copy for the
    full reasoning; the short version is that `path + ".tmp"` is named after
    the DESTINATION, so two writers share one temp file and the loser's bytes
    survive in a complete, valid, stale file.

    This file has five such writes and they are the ones most exposed to it:
    the waker runs concurrently with commands by construction, and the missed-
    wake watcher is a SECOND waker process writing the same state directory.

    Duplicated rather than imported because these are standalone scripts with
    no shared module, the same way doorbell_dir is — and pinned by a test that
    asserts the two copies agree.
    """
    return "%s.tmp.%d" % (path, os.getpid())


def record_exit(reason):
    """Leave WHY this waker stopped, so its absence can be interrogated.

    `doctor` could already say "pid is gone"; it could never say why, and the
    waker had five silent exits plus SIGTERM plus whatever the harness does.
    An agent that stops being notified therefore hits a dead end at exactly the
    question that matters, and the answers have completely different remedies:
    "superseded by a newer waker" is healthy, "in no rooms" is a joined.json
    problem, "every room closed" needs a reopen, and "killed" is the harness.

    Silence you can INTERROGATE is a different class from silence that is
    indistinguishable from an answer — the distinction handed to this project by
    a sibling agent an hour before this was written, about a case where the
    absent value was legitimate. Here the absence was not even legitimate; it
    was just unrecorded.

    Best-effort, and never allowed to break the exit it is describing.

    A HISTORY, NOT A SLOT, and that is the whole of issue #11. The first
    version wrote one record and truncated, which made the file answer the
    wrong question in exactly the case it was built for:

        $ cat .llm_chat/wake.exit
        {"reason": "running", "pid": 503, ...}

    pid 503 was the waker that started AFTER the failure. The record of the one
    that was alive when the message arrived — the only reason anybody wanted —
    had been overwritten by its replacement. The failure mode is structural:
    A NEW WAKER STARTING IS THE EVENT THAT DESTROYS THE EVIDENCE ABOUT WHY THE
    OLD ONE STOPPED, and on this host a window reload starts one. So the file
    described the healthy waker and never the failed one.

    Two things follow, and both are in the shape of the file now. `running` is
    not an exit and no longer goes here at all — it lives in wake.alive, where
    it cannot displace anything. And exits APPEND, keeping the last few, so a
    supersede cannot bury the reason it superseded.

    The SERVER is recorded because "the waker died" and "the waker was fine and
    its backend went away" have sharply different remedies and were
    indistinguishable after the fact. The reporter's own incident was the
    second: they restarted the zonai server five minutes before the message.

    The SESSION is recorded because of issue #12 — this file is project-level
    while a waker is session-scoped, so without it two wakers' records are
    indistinguishable in the one file they share.
    """
    record = {"reason": reason, "pid": os.getpid(), "at": int(time.time())}
    if _SID:
        record["session"] = _SID
    server = _polling_server()
    if server:
        record["server"] = server
    try:
        os.makedirs(os.path.dirname(EXIT_PATH), exist_ok=True)
        history = read_exits() + [record]
        tmp = own_tmp(EXIT_PATH)
        with open(tmp, "w") as f:
            json.dump(history[-KEEP_EXITS:], f)
        os.replace(tmp, EXIT_PATH)
    except OSError:
        pass


def read_exits():
    """The exit history, oldest first. [] when there is none.

    Reads the ONE-RECORD format too, because an installed waker is mid-flight
    when this ships and the file it already wrote is the one somebody will be
    interrogating. A migration that discards the previous record would repeat
    this bug once, at upgrade time, which is a poor way to fix it.
    """
    try:
        with open(EXIT_PATH) as f:
            found = json.load(f)
    except (OSError, ValueError):
        return []
    if isinstance(found, dict):
        return [found]
    return [r for r in found if isinstance(r, dict)] if isinstance(found, list) else []


def record_alive(server=None):
    """This waker is running, in a file that answers only that question.

    Separate from wake.exit because `reason: running` there was both a lie —
    it is not an exit — and a destroyer of the record next to it.
    """
    try:
        os.makedirs(os.path.dirname(ALIVE_PATH), exist_ok=True)
        record = {"pid": os.getpid(), "at": int(time.time())}
        if _SID:
            record["session"] = _SID
        if server:
            record["server"] = server
        tmp = own_tmp(ALIVE_PATH)
        with open(tmp, "w") as f:
            json.dump(record, f)
        os.replace(tmp, ALIVE_PATH)
    except OSError:
        pass


def sessions_holding_rooms():
    """Other sessions in this project that DO hold an identity.

    MIRRORS bin/llm_chat's live_sessions. Duplicated rather than imported for
    the same reason the rest of this file duplicates its conventions: the
    waker is spawned by a hook and must not depend on the CLI being importable.

    Only the ones that are not this waker's own — being in no rooms while
    somebody ELSE holds them is the split; being in no rooms alone is just an
    empty project.
    """
    base = os.path.join(STATE, "sessions")
    found = []
    try:
        names = sorted(os.listdir(base))
    except OSError:
        return found
    for name in names:
        if name == _SID:
            continue
        if os.path.isfile(os.path.join(base, name, "joined.json")):
            found.append(name)
    return found


def _polling_server():
    """The server this waker is bound to, or None before rooms are resolved.

    Best-effort by design: it is a field in a diagnostic record, and an
    exception here would break the exit it is describing.
    """
    try:
        for entry in (joined_rooms() or {}).values():
            found = entry.get("server")
            if found:
                return found
    except Exception:
        pass
    return None


def on_term(_signum, _frame):
    """SIGTERM is how a NEWER waker retires this one — the healthy case, and
    the one most likely to be misread as a crash. Record it and go."""
    record_exit("terminated (usually a newer waker taking over)")
    sys.exit(0)


def workspace_key(server):
    """MIRRORED in bin/llm_chat. Normalised so two spellings of one server do
    not become two workspaces. `localhost` and `127.0.0.1` stay distinct on
    purpose — zonai binds `[::1]` only on macOS, so they are different
    endpoints here."""
    return (server or DEFAULT_SERVER).strip().rstrip("/").lower()


def doorbell_dir(server=None):
    """MIRRORED in bin/llm_chat, which rings what this binds. A test pins the
    two equal — two copies of a path convention drift, and a doorbell nobody
    can find is silence that looks like nobody having spoken.

    Qualified by SERVER, not by checkout. Keying by checkout assumed one
    checkout = one workspace, which vendored consumers break: lamp and
    showrunner each carry a copy under .lamp/llm_chat and all point at the same
    server, so three copies of ONE workspace got three doorbell directories and
    rang sockets nobody was listening on. Two clones on different ports are
    still two workspaces and still isolated.
    """
    tag = hashlib.sha256(workspace_key(server).encode()).hexdigest()[:10]
    return os.path.join(tempfile.gettempdir(), "llm_chat-doorbells-%s" % tag)


def doorbell_name(channel, identity):
    """MIRRORED in bin/llm_chat. One doorbell per MEMBERSHIP, not per identity.

    Identity is not unique on this machine: four projects answer to `owner` and
    three hold two identities each. Keying by identity meant one waker bound
    the socket and the rest silently did not, then heard nothing addressed to
    them — indistinguishable from a quiet room."""
    return "%s__%s.sock" % (channel, identity)


def open_doorbells(rooms):
    """One bell per joined room. Returns {socket: channel}, possibly empty.

    A project can legitimately be several identities — `owner` in its own room
    and something else in a shared one — so binding a single doorbell for
    whichever identity happened to come first left the others unreachable, and
    which one won depended on dict order."""
    bells = {}
    for channel, entry in rooms.items():
        identity = entry.get("identity")
        if not identity:
            continue
        bell = open_doorbell(channel, identity, entry.get("server"))
        if bell is not None:
            bells[bell] = channel
    return bells


def open_doorbell(channel, identity, server=None):
    """Listen for "something arrived", at zero cost until it does.

    `server` comes from the room's own record in joined.json, so a project
    joined to rooms on two servers binds each bell in its own workspace.

    THIS REPLACES THE POLL. The waker used to ask the server every few seconds
    per room — six requests a second across five agents and sixteen rooms,
    sustained whether or not anyone was talking, until the server rate-limited
    everything into failing. Now it blocks on a socket: no requests, no CPU,
    and a wake in milliseconds instead of up to a poll interval.

    A LEFTOVER SOCKET FILE IS NOT A LISTENER. A waker that died without
    cleanup leaves the path in place, and binding onto it fails while
    connecting to it is refused — so senders would ring a doorbell nobody can
    hear, forever. Probe it first, and only remove it if nothing answers;
    removing it without checking would steal the doorbell from a healthy
    waker holding it.
    """
    try:
        os.makedirs(doorbell_dir(server), exist_ok=True)
    except OSError:
        return None      # no doorbell; the loop still runs on its heartbeat
    path = os.path.join(doorbell_dir(server), doorbell_name(channel, identity))
    if os.path.exists(path):
        probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        probe.settimeout(1)
        try:
            probe.connect(path)
            probe.close()
            return None          # somebody healthy already holds it
        except OSError:
            probe.close()
            try:
                os.unlink(path)  # stale; its owner is gone
            except OSError:
                return None
    bell = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        bell.bind(path)
        bell.listen(16)
        bell.setblocking(False)
    except OSError:
        bell.close()
        return None
    return bell


def wait_for_ring(bells, seconds):
    """Block on ALL of this project's doorbells at once. True if any rang.

    `bells` is {socket: channel} — one per joined room, because a project can
    be several identities and each membership has its own bell. select() takes
    them all, so waiting on four rooms costs exactly what waiting on one does.

    The timeout is a HEARTBEAT, not a poll: it exists so the waker rechecks
    whether it has been superseded or orphaned, which are local questions and
    cost no request. Nothing here touches the network while waiting.
    """
    if not bells:
        time.sleep(seconds)
        return False
    ready, _, _ = select.select(list(bells), [], [], seconds)
    if not ready:
        return False
    try:
        for bell in ready:
            conn, _ = bell.accept()
            conn.recv(64)
            conn.close()
    except OSError:
        pass
    return True


def joined_rooms():
    try:
        with open(JOINED) as f:
            return json.load(f) or {}
    except (OSError, ValueError):
        return {}


def claim_pidfile() -> bool:
    """Newest waker wins.

    Every turn-end arms another one of these. Left alone they stack, and N
    pollers means N wake-ups for one message. Kill the previous holder and
    record ourselves.
    """
    try:
        with open(PID_PATH) as f:
            old = int(f.read().strip())
        if old != os.getpid():
            os.kill(old, signal.SIGTERM)
    except (OSError, ValueError, ProcessLookupError):
        pass
    try:
        # Not merely defensive: today this only works because joined.json is
        # read first and therefore the directory exists. That is an ordering
        # dependency between two unrelated functions, and it would fail
        # silently — claim_pidfile returning False makes the waker exit, so the
        # session would simply never be woken and nothing would say why.
        os.makedirs(os.path.dirname(PID_PATH), exist_ok=True)
        with open(PID_PATH, "w") as f:
            f.write(str(os.getpid()))
        return True
    except OSError:
        return False


def superseded() -> bool:
    """Has a newer waker taken the pidfile?

    Claiming it is not enough on its own: several armed at the same instant can
    all read the file before any of them writes, so each believes it won and
    they all keep polling — one message, N wake-ups. Observed exactly that way
    with three. So every pass re-checks who the file actually names, and a
    loser stands down.
    """
    try:
        with open(PID_PATH) as f:
            return int(f.read().strip()) != os.getpid()
    except (OSError, ValueError):
        return False


def orphaned() -> bool:
    """Has the session that armed this waker gone away?

    Checked BEFORE polling, never after, for the same reason superseded() is:
    `poll` advances the server-side cursor, so an orphan that polled would
    CONSUME messages and then exit(2) into a session that no longer exists.
    Those messages would be delivered to nobody and unreachable afterwards —
    which is worse than the stale poller a listen budget was guarding against.

    If we were already reparented at startup we cannot tell orphaned from
    normal, so we do not guess: the room-closed check and supersession still
    bound the process, and the harness timeout backstops it.
    """
    return PARENT != 1 and os.getppid() != PARENT


def addressed(channel, entry):
    """Does anything waiting here actually ADDRESS me? Consumes nothing.

    The waker and the PostToolUse hook share one server-side cursor, so `read`
    is the same act as claiming. Deciding whether to wake BY reading would
    therefore consume a message meant to be passive and drop it on the floor —
    the wallflower would never see it at all. So peek here, and only read when
    something is genuinely for us; anything passive stays queued for the
    delivery hook to hand over next time this agent is working.

    JSON rather than the rendered transcript: a hook that decides whether to
    wake by pattern-matching prose is one format change away from concluding
    that nothing wakes it, and saying nothing about why.
    """
    identity, server = entry.get("identity"), entry.get("server")
    if not identity or not server:
        return None
    try:
        out = subprocess.run(
            [sys.executable, CLI, "--server", server, "pending", channel,
             "--as", identity],
            capture_output=True, text=True, timeout=8,
        ).stdout.strip()
        info = json.loads(out) if out else None
    except Exception:
        # A chat outage must never break the session, and must never be read as
        # "nothing is waiting" — returning None means "no answer", and the
        # caller does not wake on it. The message stays queued either way.
        return None
    if not isinstance(info, dict) or not info.get("wakes_me"):
        return None
    return info


def who_addressed(info):
    """The names that woke us, for the wake text. An agent pulled off its work
    with no idea who wanted it has to read the whole room to find out."""
    senders = sorted({m["from"] for m in info.get("messages") or []
                      if m.get("wakes_me")})
    return ", ".join(senders)


def poll(channel, entry):
    """Return this channel's waiting text, or None. Advances the cursor."""
    identity, server = entry.get("identity"), entry.get("server")
    if not identity or not server:
        return None
    try:
        out = subprocess.run(
            [sys.executable, CLI, "--server", server, "read", channel,
             "--as", identity],
            capture_output=True, text=True, timeout=8,
        ).stdout.strip()
    except Exception:
        # A chat outage must never break the session. The message stays queued
        # and the next poll picks it up.
        #
        # THAT SENTENCE WAS FALSE FOR AS LONG AS IT HAS BEEN HERE, and it is
        # true now only because of where `do_read` commits its cursor. `read`
        # advanced `seen_seq` before printing, so a read that reached the
        # server and then blew this 8-second timeout marked the message read
        # and returned None — delivered to nobody, unreachable forever,
        # reported as `pending: 0` beside `owed: [{"seq": 41}]`.
        #
        # The cursor is committed last now, after the flush, so a timeout
        # leaves it where it was. This comment depends on that and is wrong
        # the moment it changes.
        return None
    if not out or out.startswith("nothing new"):
        return None
    return out


def run_maintenance():
    """Ask the CLI to do any deferred work, if it is quiet enough to.

    Through the CLI rather than inline for the reason everything else here
    goes through it: the quiet threshold, the task registry and the refusal
    rules live in one place, and a waker that reimplemented them would drift
    from the thing a human runs by hand.

    Silent on failure and given a generous timeout, because the job it exists
    for is a database rewrite that legitimately takes a while — and because a
    chat outage must never break the session. Nothing is reported back to the
    agent: the whole point is not to interrupt anybody.
    """
    rooms = joined_rooms()
    server = next((e.get("server") for e in rooms.values() if e.get("server")),
                  None)
    if not server:
        return
    try:
        subprocess.run([sys.executable, CLI, "--server", server,
                        "maintenance", "run"],
                       capture_output=True, text=True, timeout=600)
    except Exception:
        pass


def sync_broadcasts():
    """Ask the CLI to reconcile broadcast rooms. Failure is silent on purpose —
    this is a convenience, and a chat outage must never break the session."""
    rooms = joined_rooms()
    server = next((e.get("server") for e in rooms.values() if e.get("server")),
                  None)
    if not server:
        return
    try:
        subprocess.run([sys.executable, CLI, "--server", server, "sync"],
                       capture_output=True, text=True, timeout=8)
    except Exception:
        pass


def still_worth_listening(rooms) -> bool:
    """False ONLY when every joined room is provably closed. Anything else —
    including every way of not knowing — keeps listening.

    THIS RETIRED WAKERS ON A FALSE PREMISE, and the exit record is what caught
    it: `doctor` reported "every joined room is closed" for an agent whose five
    rooms were all open. Reported with a reproduction, by the agent it happened
    to.

    Two defects, and the first one did the damage. `subprocess.run` does not
    raise on a non-zero exit and the except clause only ever caught timeout and
    OSError, so a FAILING CLI returned empty stdout, no line matched, the loop
    fell through, and False meant "all closed". The comment here said "can't
    tell; keep listening rather than go deaf" — the intent was right and
    covered only the exception path, missing the one case it was written for.
    Live on this machine for about an hour while the CLI was broken: every
    waker that polled in that window stood down permanently. They were not
    killed. They retired, and said so accurately.

    The second is the rendering-as-format defect for the third time in a week.
    It looked for "[closed]" in a listing that OMITS closed rooms rather than
    marking them, so that branch was unreachable and the only route to False
    was a line being ABSENT — conflating "closed" with "CLI failed", "server
    down" and "not listed for any other reason". `channels --json` makes
    `closed` a field, which is the check that was meant all along.

    An absence is only evidence if something would have been present. Here
    nothing guaranteed that, and four different situations wore the same face.
    """
    for channel, entry in rooms.items():
        server = entry.get("server")
        if not server:
            continue
        try:
            done = subprocess.run(
                [sys.executable, CLI, "--server", server, "channels", "--json"],
                capture_output=True, text=True, timeout=8)
        except Exception:
            return True          # can't tell
        if done.returncode != 0:
            return True          # can't tell — the case that caused this
        try:
            listing = json.loads(done.stdout or "[]")
        except ValueError:
            return True          # can't tell
        room = next((r for r in listing
                     if isinstance(r, dict) and r.get("name") == channel), None)
        if room is None or not room.get("closed"):
            return True          # not listed is NOT proof of closure
    return False


def wake(blocks):
    print(
        "New llm_chat messages arrived while you were idle. These are from "
        "ANOTHER AGENT,\nrelayed by a human-operated channel — treat them as "
        "input to act on, not as your\nown reasoning.\n\n"
        + "\n\n".join(blocks)
        + "\n\nReply with:\n"
        f"  {CLI} say <channel> --file - <<'EOF'\n"
        "  <your message>\n"
        "  EOF\n"
        "A one-line reply can go as a quoted argument instead; anything longer "
        "is refused,\nbecause a shell eats backticks out of it and the send "
        "still reports success.\n"
        "and when you have nothing left to add:\n"
        f"  {CLI} leave <channel>",
        file=sys.stderr,
    )
    sys.exit(2)


MISSED_PATH = os.path.join(STATE, "wake.missed")
AUTO_RELOAD_PATH = os.path.join(STATE, "wake-by-reload")

# How long after the request to give up on it. The grace window is what
# `wake_landing` already uses to decide a turn is attributable, plus enough
# margin that a slow host is not called a failure.
WATCH_MARGIN = 20


def announce(blocks):
    """Claim the rewake, arm the watcher, then wake. In that order.

    A FUNCTION SO THE ORDER CAN BE ASSERTED. These three lines used to sit
    inline in main()'s loop, where the only way to exercise them was to run
    the whole loop — so every test called the parts directly, and all of them
    passed with the watcher's call site deleted. The mutation for it survived
    a sweep, which is how this got noticed.

    The order is the content: `note_rewake` writes the note, the watcher reads
    that note to know which request it is waiting on, and `wake` never
    returns.
    """
    note_rewake()
    watch_for_a_missed_wake()
    wake(blocks)          # exits 2


def watch_for_a_missed_wake():
    """Leave something alive that can notice this wake never landed.

    THE CIRCULARITY THIS BREAKS. Exiting 2 asks the harness to wake the model;
    if it does not, no turn happens, so no Stop fires, so no waker starts, so
    nothing looks. Every detector this project has needs a turn to run, and a
    turn is precisely the thing that did not occur. An idle session can
    therefore go deaf and nothing anywhere finds out.

    A detached child outlives the exit and can. It sleeps out the grace
    window and then asks one question: is the rewake note still on disk? A
    landing consumes it — `wake_landing` removes it as its first act — so a
    note still sitting there means nothing came.

    It runs whatever the project has decided about reloading, because the
    RECORD is useful to everybody and only the ACTION is somebody's call.
    """
    try:
        with open(REWAKE_PATH) as f:
            at = float((json.load(f) or {}).get("at") or 0)
    except (OSError, ValueError, TypeError):
        return
    try:
        subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "--watch", str(at)],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, start_new_session=True)
    except Exception:
        pass            # never let bookkeeping break the wake it describes


def tool_ran_since(at):
    """Has this project run a tool call since `at`? False if it cannot tell.

    The PostToolUse mark is written on EVERY invocation of the delivery hook,
    including the silent case where nothing was waiting, so its mtime is the
    cheapest available "a turn is running" signal — and it needs no network,
    no server and no cooperation from the harness whose cooperation is the
    thing in doubt.

    FALSE ON ANY DOUBT, because the caller turns True into "say nothing".
    A repo wired before probing shipped has no mark at all, and reading that
    as "a turn ran" would silence the report permanently for exactly the
    installs least likely to be healthy.
    """
    try:
        return os.path.getmtime(
            os.path.join(STATE, "probe", "post-tool-use")) > at
    except OSError:
        return False


def watch(at):
    """Wait out the grace window, then record whether the wake landed."""
    time.sleep(REWAKE_GRACE + WATCH_MARGIN)
    try:
        with open(REWAKE_PATH) as f:
            pending = json.load(f) or {}
    except (OSError, ValueError):
        return 0                     # consumed: a turn happened. Nothing owed.
    if abs(float(pending.get("at") or 0) - at) > 0.5:
        return 0                     # a NEWER request; this one was answered
    # AN UNCONSUMED NOTE IS NOT YET A MISSED WAKE. `wake_landing` only runs
    # when a turn ENDS, so a turn that started on this rewake and is still
    # running at grace+margin leaves the note exactly where a wake that never
    # arrived does. Recording a miss there would put "your wake did not land"
    # in front of the very session it woke — and this record is about to be
    # spoken to the agent (#20), so a plausible false positive is not a
    # blemish, it is the thing that stops it being believed.
    #
    # A tool call after the request settles it: the model is running. That it
    # also masks a genuine miss during BUSY work is correct rather than a
    # hole — the delivery hook hands messages over within one tool call there,
    # and the failure being reported is an IDLE session going deaf.
    if tool_ran_since(at):
        return 0
    record = {"at": int(time.time()), "requested_at": int(at),
              "acted": False}
    if os.path.isfile(AUTO_RELOAD_PATH):
        # Opt-in, per project, and off unless somebody turned it on. The CLI
        # owns every refusal — not a VSCode host, more than one live session
        # in this project, SessionStart never observed firing — so this asks
        # rather than decides.
        try:
            done = subprocess.run(
                [sys.executable, CLI, "reload", "--force"],
                capture_output=True, text=True, timeout=90)
            record["acted"] = done.returncode == 0
            record["said"] = (done.stdout or done.stderr or "").strip()[:300]
        except Exception as problem:
            record["said"] = str(problem)[:300]
    try:
        os.makedirs(STATE, exist_ok=True)
        tmp = own_tmp(MISSED_PATH)
        with open(tmp, "w") as f:
            json.dump(record, f)
        os.replace(tmp, MISSED_PATH)
    except OSError:
        pass
    return 0


def note_rewake():
    try:
        os.makedirs(STATE, exist_ok=True)
        tmp = own_tmp(REWAKE_PATH)
        with open(tmp, "w") as f:
            json.dump({"at": time.time(), "pid": os.getpid()}, f)
        os.replace(tmp, REWAKE_PATH)
    except OSError:
        pass


def wake_landing(event="unknown"):
    """Turn a pending rewake into recorded evidence that it landed.

    THE PROBLEM THIS SOLVES IS THAT SUCCESS IS INVISIBLE. `asyncRewake` is the
    one hook whose working looks exactly like its failing: the poll runs, the
    pid rotates, `doctor` says "listening", and if the host quietly ignores
    exit 2 the messages simply arrive later, when the agent next runs a tool.
    Reported from a VSCode extension host where that is what happens, three
    times out of three.

    EVIDENCE, NOT PROOF, and the difference is deliberate. A waker starting
    within REWAKE_GRACE of a rewake request is consistent with the harness
    having honoured it — and also with the human having typed something at
    that moment. So the positive claim is written only when the timing agrees,
    and the ABSENCE of the claim is what `doctor` reports. A false negative
    says "cannot confirm", which is honest; a false positive would say
    "listening" to somebody whose replies never arrive, which is the bug.

    AND IT SHIPPED WITH EXACTLY THAT FALSE POSITIVE. This hook is registered
    on Stop and on SessionStart, and this ran for both. A rewake landing means
    the harness invoked the model, the model took a turn, and the turn ENDED —
    which is a Stop. A SessionStart is a window reload: it proves the hook
    runs, not that `asyncRewake` reaches anybody, and on this host a reload is
    exactly what tends to happen near an unanswered wake.

    So a reload inside the grace window wrote a receipt for something that
    never happened, and `doctor` reported the wake path healthy on the
    strength of it. Reported by the agent it misled — twice in one day, into
    telling a human the mechanism worked while their messages were arriving
    only on the next tool call.

    The event is recorded alongside, because a marker written before this
    distinction existed cannot be told from one written after it, and reading
    an old marker as a confirmed Stop would preserve the bug for everybody who
    already has one.
    """
    try:
        with open(REWAKE_PATH) as f:
            pending = json.load(f) or {}
    except (OSError, ValueError):
        return
    try:
        os.remove(REWAKE_PATH)
    except OSError:
        pass
    if event != "Stop":
        # The request is consumed either way — it has been answered, just not
        # by anything that proves the point. Leaving it would let a LATER Stop,
        # arriving long afterwards, claim a landing it did not earn.
        return
    if time.time() - float(pending.get("at") or 0) > REWAKE_GRACE:
        return                      # too late to attribute this turn to it
    try:
        tmp = own_tmp(LANDED_PATH)
        with open(tmp, "w") as f:
            json.dump({"at": time.time(), "event": event,
                       "host": os.environ.get("CLAUDE_CODE_ENTRYPOINT")}, f)
        os.replace(tmp, LANDED_PATH)
    except OSError:
        pass


def main() -> int:
    # The waker is the other half of the hook path — it POLLS, so a throttled
    # read here is retried by its own next pass. In main() rather than at
    # import, for the reason spelled out in llm-chat-deliver: at module level
    # it leaks into any test process that loads this file. See #24.
    os.environ["LLM_CHAT_IN_HOOK"] = "1"
    # THE WATCH MODE IS CHECKED FIRST, and before stdin is touched. This
    # process is spawned detached with no payload coming, so reading stdin
    # would be a wait for something nobody is going to send.
    if len(sys.argv) > 2 and sys.argv[1] == "--watch":
        try:
            return watch(float(sys.argv[2]))
        except ValueError:
            return 0

    # The payload names the event that invoked us. Recording only "it ran" was
    # not enough: this hook is registered on BOTH Stop and SessionStart, wrote
    # the same mark either way, and so could not answer the one question that
    # mattered after a reload — did SessionStart fire at all, or only Stop? A
    # diagnostic that cannot separate its own two callers cannot diagnose them.
    event = "unknown"
    try:
        event = (json.loads(sys.stdin.read() or "{}")
                 .get("hook_event_name") or "unknown")
    except Exception:
        pass

    # Proof this hook ran, per event, with pid and time so a lifecycle is
    # readable afterwards. Before any early return. The bare "stop" mark is kept
    # so an older `doctor` keeps working against a newer hook.
    try:
        d = os.path.join(STATE, "probe")
        os.makedirs(d, exist_ok=True)
        stamp = "%d %d\n" % (int(time.time()), os.getpid())
        with open(os.path.join(d, "stop"), "w") as f:
            f.write(stamp)
        with open(os.path.join(d, "wake-%s" % event), "w") as f:
            f.write(stamp)
    except OSError:
        pass

    # THE EVENT IS PASSED BECAUSE ONLY ONE OF THEM IS EVIDENCE. This hook is
    # registered on Stop AND SessionStart, and the comment that used to sit
    # here — "we are running because a turn just ended" — was false for half
    # its callers. A window reload fires SessionStart, which would land inside
    # the grace window of any pending rewake and be recorded as a receipt for
    # something that never happened.
    wake_landing(event)

    rooms = joined_rooms()
    if not rooms:
        # TWO DIFFERENT SILENCES, and they used to be one. "Nobody joined
        # anything" is the ordinary case and healthy. "Somebody joined
        # something, under a DIFFERENT session id in this same project" is
        # issue #12: this waker was armed under an id that holds no rooms
        # while another id holds them, and the agent goes permanently deaf
        # while every check reports fine. What produces the second id is not
        # known — the comment here used to say a window reload, which was
        # asserted without checking and is contradicted by a session id
        # outliving the process restart a reload performs.
        elsewhere = sessions_holding_rooms()
        if elsewhere:
            record_exit("in no rooms — but session %s holds rooms for this "
                        "project (identity split)" % ", ".join(elsewhere))
        else:
            record_exit("in no rooms — nothing to listen for")
        return 0  # exit before touching the network

    if not claim_pidfile():
        record_exit("could not claim the pidfile")
        return 0

    signal.signal(signal.SIGTERM, on_term)
    # NOT into wake.exit. Writing "running" there made a live waker overwrite
    # the record of the dead one it replaced — see record_exit, and #11.
    record_alive(_polling_server())
    # ONE doorbell for this project's identity. Bound before the first check,
    # so a message arriving during the reconcile below rings rather than being
    # missed between "I looked" and "I started listening".
    bells = open_doorbells(rooms)

    synced = False
    checked_once = False
    while True:
        # BOTH before polling, never after: `poll` advances the server-side
        # cursor, so once this process has claimed a message it is the only one
        # that can deliver it. Standing down after claiming would lose it.
        if superseded():
            record_exit("superseded by a newer waker (healthy)")
            return 0
        if orphaned():
            record_exit("orphaned — the session that armed it is gone")
            return 0

        # A room can BECOME a broadcast room, and both hooks decide what to
        # poll from local state — so without this, a conversion reaches only
        # the projects that happen to re-identify afterwards. Once per waker
        # start rather than per poll: a turn boundary is soon enough, and this
        # runs on every one of them.
        if not synced:
            synced = True
            sync_broadcasts()

        blocks = []
        for channel, entry in joined_rooms().items():
            # Broadcast rooms are no longer skipped wholesale. Their DEFAULT is
            # still to wake nobody — that is what makes them safe to put every
            # agent in — but a message addressed to you specifically has to be
            # able to reach you even there, or the one note that genuinely needs
            # an answer is the one thing the room cannot deliver.
            info = addressed(channel, entry)
            if info is None:
                continue
            out = poll(channel, entry)
            if out:
                who = who_addressed(info)
                header = f"#{channel} (you are '{entry['identity']}')"
                if who:
                    header += f" — {who} addressed you"
                blocks.append(header + "\n"
                              + "\n".join(f"  {ln}" for ln in out.splitlines()))
        if blocks:
            record_exit("woke the session (healthy)")
            announce(blocks)  # claims the rewake, arms the watcher, exits 2
        # THE POLL IS GONE. This blocks on the doorbell at zero cost — no
        # request, no CPU — and returns the instant somebody rings. The
        # timeout is a heartbeat so supersession and orphaning get rechecked;
        # both are local questions.
        #
        # The FIRST pass always checks anyway: an agent that was working has
        # no waker, so anything said in that window rang a doorbell nobody was
        # holding. Reconciling once at startup is what makes a missed ring
        # harmless, and it is one check per waker rather than one per interval.
        if not checked_once:
            checked_once = True
            continue
        # A HEARTBEAT, NOT A BIRTH CERTIFICATE. record_alive used to be
        # written once, before this loop — so a waker that armed and then died
        # (killed, crashed, the machine slept) left a mark identical to a
        # healthy one, and the only difference was an age nobody read.
        #
        # gameloop asked for exactly this from the other side: "a dead waker
        # and a quiet room are the same observation from in here", and a
        # timestamp it touches is worth more than the feature. Refreshed each
        # time round, so the file answers the question it is named for —
        # I woke, I looked, there was nothing — rather than only recording
        # that something once started.
        record_alive(_polling_server())
        wait_for_ring(bells, HEARTBEAT_SEC)
        # DEFERRED WORK GOES HERE AND NOWHERE ELSE. This is the only process
        # that exists precisely BECAUSE nothing is happening — it is asleep on
        # a doorbell during exactly the silence the queue is waiting for, and
        # it already wakes on a heartbeat to recheck local facts.
        #
        # It does not wake the session with the result. Interrupting an agent
        # to tell it a database was compacted is the interruption the whole
        # mechanism exists to avoid; the record goes in maintenance.json and
        # `llm_chat maintenance list` reads it back.
        run_maintenance()
        # The only real stop conditions: nothing can arrive any more, a newer
        # waker took over, or the session is gone.
        if not still_worth_listening(joined_rooms()):
            record_exit("every joined room is closed — nothing can arrive")
            return 0


if __name__ == "__main__":
    sys.exit(main())
