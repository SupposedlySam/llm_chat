#!/usr/bin/env python3
"""Deliver waiting llm_chat messages into a running Claude Code session.

Registered as a **PostToolUse** hook in each participating repo, so it runs
after every tool call. When something is waiting it returns
`hookSpecificOutput.additionalContext`, which the harness injects before the
model's next step — the same channel the IDE already uses to hand over analyzer
diagnostics.

That is what makes this a conversation rather than a mailbox: a reply lands
**within one tool call**, mid-turn, instead of at turn-end or on a poll the
agent has to remember to run. An agent deep in a refactor hears you.

Silence is the default. With nothing waiting it prints nothing and exits 0, so
it costs one loopback request per tool call and never adds noise.

Install into a repo with `install.sh <path-to-repo>`.
"""
import json
import os
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
CLI = os.path.join(HERE, "llm_chat")
ROOT = os.path.dirname(HERE)

# Per calling project — see `joined_path()` in the CLI. Two agents on one
# machine share the llm_chat checkout but not their identities, and a shared
# record would deliver A's messages to B.
def _project_dir():
    """Root of the calling repo — never the raw cwd.

    Mirrors project_dir() in bin/llm_chat; kept inline because this runs on
    every tool call and cannot afford a subprocess to ask. `.llm_chat/` lives at
    a project's root, so resolving to a subdirectory splits one project into
    two identities and this hook would then read the wrong one.
    """
    env = os.environ.get("CLAUDE_PROJECT_DIR")
    if env:
        return os.path.abspath(env)
    here = probe = os.path.abspath(os.getcwd())
    while True:
        if (os.path.isdir(os.path.join(probe, ".llm_chat"))
                or os.path.isdir(os.path.join(probe, ".git"))):
            return probe
        parent = os.path.dirname(probe)
        if parent == probe:
            return here
        probe = parent


PROJECT = _project_dir()
JOINED = os.path.join(PROJECT, ".llm_chat", "joined.json")


def joined_for(session_id):
    """This session's rooms, falling back to the project's.

    MIRRORS bin/llm_chat's resolution, and takes the id from the HOOK PAYLOAD
    rather than the environment — the payload is the one place it is
    guaranteed, and a hook that guessed wrong would deliver one session's
    messages to another, which is the exact incident this scoping exists to
    stop. The env var is the fallback, for a hook invoked without a payload.

    Reading the project file when the session has none is migration, not a
    default: an agent already in rooms must not have to re-join.
    """
    sid = (session_id or os.environ.get("CLAUDE_CODE_SESSION_ID") or "").strip()
    candidates = []
    if sid:
        candidates.append(os.path.join(PROJECT, ".llm_chat", "sessions", sid,
                                       "joined.json"))
    candidates.append(JOINED)
    unreadable = []
    for path in candidates:
        if not os.path.isfile(path):
            continue          # ABSENT — try the next candidate
        try:
            with open(path) as f:
                return json.load(f) or {}
        except (OSError, ValueError):
            # UNREADABLE is not ABSENT, and this line used to `return {}` —
            # the correct behaviour was already three lines up, in the same
            # loop, for the missing case. Reported by showrunner, confirmed
            # from source, and it outranks everything else found this week for
            # one reason: a resolver that reads empty makes an agent DEAF
            # while every sender sees delivery succeed, every room still lists
            # them, and `doctor` agrees with the silence because it shares the
            # resolver. Nothing in the system is positioned to notice.
            unreadable.append(path)
    if unreadable:
        # AND NOT `{}` AT THE END EITHER — wcs's refinement, which is the half
        # that `continue` alone misses. With only a `continue`, a corrupt
        # SESSION file falls through to the project file and an agent that has
        # one is rescued; an agent that has only ever joined in-session has no
        # project file, the loop runs off the end, and it is deaf again by the
        # same mechanism. That is the agent least likely to have anyone
        # checking on it.
        #
        # None is "could not look" and is NOT a room list. The caller refuses
        # on it, because a reader cannot recover the distinction once it has
        # been folded into an empty dict.
        print("llm_chat: cannot read %s — refusing to report 'no rooms', "
              "which would\n  look exactly like having nothing waiting. "
              "Repair or delete it."
              % ", ".join(unreadable), file=sys.stderr)
        return None
    return {}

# A single delivery must never be big enough to derail a turn. Two agents that
# get into a loop while this one was busy could queue a lot, and the failure
# mode of "deliver everything" is an unusable session rather than a late
# message.
MAX_PER_DELIVERY = 15

# A passive message costs every member's context, permanently, for something
# nobody asked to be interrupted for. MEASURED on this machine: 231,800 chars
# written once were delivered as 1,989,954 — 8.6x amplification, roughly half a
# million tokens, most of it into agents the messages were not addressed to.
#
# So content is delivered to whoever the message was FOR, and everybody else is
# told it exists. That is the same split the audience rules already make about
# waking, applied to context: being addressed means you need the words, being
# in the room means you need to know they were said.
MAX_PASSIVE_PREVIEW = 100

# Every hook a current install registers. Checked against what this repo
# actually has, because upgrading llm_chat does NOT upgrade a repo already set
# up: hooks are registered once, at install, so a repo wired before a hook
# existed silently never gets it and nothing says so. That is not theoretical —
# this project's own checkout ran for a day without the Stop waker, because it
# was installed before the waker was written. The owner did not notice; nobody
# else would either.
EXPECTED_HOOKS = ("llm-chat-deliver", "llm-chat-wake")


def mark_fired(hook_name):
    """Leave proof this hook ran, so its ABSENCE can be read as a diagnosis.

    Whether a hook is REGISTERED is readable from settings.json. Whether it has
    ever FIRED is not readable from anything — and that is the failure that cost
    this project a day: the file was correct on disk, the session had simply
    never loaded it, and every inspection said "configured". The only way to
    tell "configured and working" from "configured and inert" is a mark the hook
    itself writes when it runs. Borrowed from game_loop's probe/stop-payload,
    which exists because a page sat unspent for 22 hours the same way.

    Best-effort: never let bookkeeping break delivery.
    """
    try:
        d = os.path.join(PROJECT, ".llm_chat", "probe")
        os.makedirs(d, exist_ok=True)
        with open(os.path.join(d, hook_name), "w") as f:
            f.write(str(int(time.time())))
    except OSError:
        pass


def missing_hooks() -> list:
    """Which of our hooks this repo has not got registered."""
    found = set()
    for name in ("settings.local.json", "settings.json"):
        try:
            with open(os.path.join(PROJECT, ".claude", name)) as f:
                settings = json.load(f)
        except (OSError, ValueError):
            continue
        for groups in (settings.get("hooks") or {}).values():
            if not isinstance(groups, list):
                continue
            for group in groups:
                for h in group.get("hooks", []):
                    command = h.get("command") or ""
                    found.update(e for e in EXPECTED_HOOKS if e in command)
    return [e for e in EXPECTED_HOOKS if e not in found]


def source_checkout():
    """The tree this repo's hooks actually come from, for questions ABOUT that
    tree — is it dirty, has it moved on. ROOT is only a fallback."""
    try:
        with open(os.path.join(PROJECT, ".llm_chat", "installed.json")) as f:
            return (json.load(f) or {}).get("checkout") or ROOT
    except (OSError, ValueError):
        return ROOT


def stale_install():
    """(recorded, current) hook-script hashes if this repo is behind, else None.

    Asking only "is a hook missing" is blind to a hook whose SCRIPT changed
    behind an unchanged command line — the registration is identical, so
    nothing in settings.json moves. The stamp catches that.

    Shells out to the CLI rather than reimplementing the hash here: two copies
    of a fingerprint algorithm drift, and a drift detector that has drifted is
    worse than none. Affordable because this runs at most once per session —
    the cheap marker check above short-circuits every other invocation.
    """
    try:
        with open(os.path.join(PROJECT, ".llm_chat", "installed.json")) as f:
            stamp = json.load(f) or {}
    except (OSError, ValueError):
        return None
    recorded = stamp.get("fingerprint")
    if not recorded:
        return None
    # Against the tree this repo was WIRED FROM, which is not necessarily the
    # one this script happens to live in. A consumer that vendored llm_chat
    # runs its hooks out of its own copy; measuring it against ROOT reported a
    # permanent STALE for a repo matching its own source exactly, and the
    # remedy would have repointed it here and undone the vendoring.
    source = stamp.get("checkout") or ROOT
    try:
        current = subprocess.run(
            [sys.executable, CLI, "fingerprint", "--of", source],
            capture_output=True, text=True, timeout=8,
        ).stdout.strip()
    except Exception:
        return None
    return (recorded, current) if current and current != recorded else None


# How far into the project to look for a second copy. Vendored payloads sit
# shallow — `.lamp/llm_chat`, `vendor/llm_chat`, a submodule — and an
# unbounded walk on a hook that runs after every tool call is not worth a
# rarer catch.
VENDOR_DEPTH = 4
SKIP_DIRS = {".git", "node_modules", ".venv", "venv", "build", "dist",
             "__pycache__", ".dart_tool", "target", ".llm_chat"}


def other_checkouts():
    """Other llm_chat checkouts inside this project, excluding the hooks' own.

    THIS CHECK IS ON THIS SIDE OF THE GAP ON PURPOSE, and the version before
    it was not. `doctor` also warns about a divergent build, but it lives in
    the CLI you TYPE — and divergence matters precisely when the CLI you type
    is OLD, which is when it does not contain the warning. So that check fires
    when your copy is NEWER than the hooks' tree and is silent when it is
    older, which is the common direction: a vendored payload goes stale by
    sitting still while the source moves.

    Found by gameloop, who grepped for the warning in both binaries rather
    than taking my word that it worked. Their `.lamp/llm_chat` is a genuinely
    different build with no `who` in it, and its `doctor` says nothing at all
    about that.

    A hook runs the current code BY CONSTRUCTION — its command is an absolute
    path into the tree it was installed from — so it can say what no old CLI
    can be made to say. That is the whole reason this lives here.
    """
    found, root = [], os.path.abspath(ROOT)
    stack = [(PROJECT, 0)]
    while stack:
        where, depth = stack.pop()
        if depth > VENDOR_DEPTH:
            continue
        try:
            entries = list(os.scandir(where))
        except OSError:
            continue
        for entry in entries:
            if not entry.is_dir() or entry.name in SKIP_DIRS:
                continue
            if os.path.isfile(os.path.join(entry.path, "bin", "llm_chat")):
                tree = os.path.abspath(entry.path)
                if tree != root:
                    found.append(tree)
                continue          # do not descend into a checkout we found
            stack.append((entry.path, depth + 1))
    return sorted(found)


def fingerprint_of(tree):
    """That checkout's hook-script hash, or None. Shelled out for the reason
    `stale_install` gives: a second copy of the hash algorithm drifts, and a
    drift detector that has drifted is worse than none."""
    try:
        done = subprocess.run(
            [sys.executable, CLI, "fingerprint", "--of", tree],
            capture_output=True, text=True, timeout=8)
    except Exception:
        return None
    return (done.stdout or "").strip() or None


def divergent_checkouts():
    """[(tree, its fingerprint)] for copies whose BUILD differs from ours.

    FINGERPRINTS, NOT PATHS, and that is the whole guard against crying wolf.
    A vendored copy of the same build is not a problem and must stay silent;
    so must a repo whose hooks were installed FROM its vendored copy, which
    is correctly configured and would otherwise be nagged forever about
    itself. This project has already paid twice for a warning that fired at
    the wrong population, and the second time the lesson was that a line
    permanently on and permanently wrong for its reader teaches them to skip
    it — and it will be right some day.
    """
    others = other_checkouts()
    if not others:
        return []
    mine = fingerprint_of(ROOT)
    if not mine:
        return []          # cannot compare; say nothing rather than guess
    out = []
    for tree in others:
        theirs = fingerprint_of(tree)
        if theirs and theirs != mine:
            out.append((tree, theirs))
    return out


def upgrade_notice(session_id) -> str:
    """Say it ONCE per session, or a standing gap becomes standing noise."""
    gap = missing_hooks()
    drift = stale_install()
    divergent = divergent_checkouts()
    if not gap and not drift and not divergent:
        return ""
    marker = os.path.join(PROJECT, ".llm_chat", f"wiring.{session_id or 'nosession'}")
    if os.path.exists(marker):
        return ""
    try:
        os.makedirs(os.path.dirname(marker), exist_ok=True)
        open(marker, "w").close()
    except OSError:
        return ""   # cannot record it, so do not risk repeating it every call
    # Whether the source is CLEAN, asked here rather than assumed. Duplicating
    # this one git command is fine where duplicating the fingerprint hash was
    # not: a hash is an algorithm with a convention that can drift out of step,
    # this is a question with exactly one answer and no convention to disagree
    # about.
    dirty = None
    try:
        done = subprocess.run(
            ["git", "-C", source_checkout(), "status", "--porcelain"],
            capture_output=True, text=True, timeout=10)
        dirty = bool(done.stdout.strip()) if done.returncode == 0 else None
    except Exception:
        pass

    # A SEPARATE BLOCK, not a bullet under the sentence below. "This repo is
    # running an OLDER wiring" is false here — the wiring is fine and the
    # hooks are current. What is wrong is that the agent is probably TYPING a
    # different program than the one delivering its messages, and `install.sh`
    # is not the remedy for that.
    blocks = []
    if divergent:
        said = ["llm_chat: THERE IS ANOTHER llm_chat CHECKOUT IN THIS REPO, "
                "AND IT IS A DIFFERENT BUILD.",
                "  hooks run from : %s" % ROOT,
                "  also here      : %s"
                % "\n                   ".join(t for t, _ in divergent),
                "  Your hooks are absolute paths into the first one, so "
                "DELIVERY is current.",
                "  But `llm_chat …` typed by hand may reach the other copy, "
                "and if that one is",
                "  older it will be missing checks and verbs this one has — "
                "including, when it",
                "  is old enough, the `doctor` line that would have told you "
                "any of this.",
                "  Run the hooks' copy to be sure:",
                "    %s doctor" % os.path.join(ROOT, "bin", "llm_chat")]
        blocks.append("\n".join(said))
    if not gap and not drift:
        return "\n\n".join(blocks)

    lines = ["llm_chat: this repo is running an OLDER wiring than the checkout "
             "it points at."]
    if gap:
        lines.append(
            f"  missing hook(s): {', '.join(gap)} — registered once at install, "
            "so a repo\n  set up before a hook existed never gets it."
            + ("\n  Without llm-chat-wake, nothing reaches this session while it "
               "is idle." if "llm-chat-wake" in gap else "")
        )
    if drift:
        if dirty:
            lines.append(
                "  NOTE: that checkout has UNCOMMITTED changes — re-installing "
                "wires you to them,\n  not to a commit anybody blessed. One "
                "fingerprint behind on a committed hook is\n  usually the "
                "safer side of this.")
        lines.append(f"  hook scripts changed: wired from {drift[0]}, checkout "
                     f"now has {drift[1]}.\n  The command line is identical, so "
                     "nothing in settings.json shows this.")
    lines.append(f"Fix it with:\n  {os.path.join(ROOT, 'install.sh')} {PROJECT}\n"
                 "then RELOAD THE WINDOW — hooks are read when a session starts, "
                 "so a newly\nwritten one stays inert until then.")
    blocks.append("\n".join(lines))
    return "\n\n".join(blocks)


MISSED_PATH = os.path.join(PROJECT, ".llm_chat", "wake.missed")
TOLD_PATH = MISSED_PATH + ".told"
LANDED_PATH = os.path.join(PROJECT, ".llm_chat", "wake.landed")


def wake_landed_since(when) -> bool:
    """Has a rewake been observed LANDING since `when`? False if unknown.

    THE RECORD IS A FACT ABOUT A MOMENT, NOT ABOUT NOW. Caught by running
    this against real state: a miss from 20:10 the previous evening rendered
    as news the following afternoon, seventeen hours later — which is the
    same defect `doctor` already carries a scar for, where "a wake has landed
    here" stayed on screen for ninety minutes while every wake failed.

    Age alone is the wrong test, though, and that is why this asks a
    different question. A miss from last night is still the live state if
    nothing has landed since; a miss from four minutes ago is spent if
    something has. Only a LATER landing retires it.

    False when there is no landing record at all — that means no wake has
    ever been seen arriving in this checkout, which is not evidence that one
    just did.
    """
    try:
        with open(LANDED_PATH) as f:
            return float((json.load(f) or {}).get("at") or 0) > when
    except (OSError, ValueError, TypeError):
        return False


def missed_wake_note() -> str:
    """Say, once, that a wake was requested for this session and never landed.

    THE RECORD ALREADY EXISTED AND NOTHING READ IT. The waker spawns a
    detached watcher that outlives its own exit precisely so somebody can
    notice a rewake that went nowhere, and it has been writing `wake.missed`
    to a file no code in this repo opens. A detector whose output nobody reads
    is not a detector; it is the same silence it was built to break, with a
    receipt.

    WHY HERE. Issue #20 is an idle session going deaf after a host restart:
    the poll keeps running, `doctor` diagnoses it exactly, and the diagnosis
    is unreachable unless somebody thinks to ask — so a roll-call message sat
    32 minutes and two agents in one room each concluded the other had gone
    quiet. The reporter's own account names this hook as what finally moved
    the message: "it reached them because one of their own tool calls happened
    to fire the PostToolUse delivery hook — not because a wake landed." That
    is the moment the fact is both known and deliverable, so that is where it
    is said.

    ONCE PER MISS. The record is not consumed — `doctor` and any later reader
    are entitled to it — so what is remembered is the `at` already spoken. A
    line repeated on every tool call would be read for a day and then filtered
    out for good, which is this project's own finding about warnings that cry
    wolf, applied to a warning it would be expensive to stop believing.
    """
    try:
        with open(MISSED_PATH) as f:
            record = json.load(f) or {}
        at = int(record.get("at") or 0)
    except (OSError, ValueError, TypeError):
        return ""
    if not at:
        return ""
    if wake_landed_since(at):
        return ""       # the path recovered; this is history, not the state
    try:
        with open(TOLD_PATH) as f:
            if int((f.read() or "0").strip() or 0) >= at:
                return ""
    except (OSError, ValueError):
        pass                     # never told, or the marker is unreadable —
        # repeating once is the cheap failure here, staying silent is not.
    try:
        os.makedirs(os.path.dirname(TOLD_PATH), exist_ok=True)
        with open(TOLD_PATH, "w") as f:
            f.write(str(at))
    except OSError:
        return ""       # cannot remember having said it, so do not start
    waited = max(0, int(time.time()) - at)
    ago = ("%dh" % (waited // 3600) if waited >= 3600
           else "%dm" % (waited // 60))
    line = [
        "llm_chat: A WAKE WAS REQUESTED FOR THIS SESSION AND NEVER LANDED "
        "(%s ago," % ago,
        "  and none has landed since — so this is the live state, not "
        "history).",
        "  Anything above reached you because a tool call fired this hook, "
        "not because",
        "  the wake path worked. While you are idle, NOTHING will arrive on "
        "its own —",
        "  so silence in a room right now is not evidence that the room is "
        "quiet.",
        "  `llm_chat doctor` has the live state. A window reload re-arms the "
        "listener.",
    ]
    if record.get("acted"):
        line.append("  (a reload was attempted automatically: %s)"
                    % (record.get("said") or "no output"))
    return "\n".join(line)


def addressed_to_me(message, identity):
    """Did this message ask for ME, or did it merely happen near me?

    Mirrors `wakes()` in the CLI minus the room default: a passive message in
    an ordinary room still wakes you, and this is not about waking. It is about
    whether you need the WORDS or only the fact.
    """
    audience = message.get("audience")
    if audience in (None, "*"):
        return audience == "*"
    if audience == "-":
        return False
    return identity in audience.split(",")


WATERMARK = os.path.join(PROJECT, ".llm_chat", "delivered.json")


def read_watermarks():
    """{channel: message_count as of the last successful read}, or {}."""
    try:
        with open(WATERMARK) as f:
            found = json.load(f)
        return found if isinstance(found, dict) else {}
    except (OSError, ValueError):
        return {}                      # unreadable is not "nothing new"


def note_delivered(channel, count):
    """Record a room's count ONLY after its read actually succeeded.

    Written after, never before. A watermark advanced on an attempt would
    make the next tick skip a room whose messages were never shown — the
    cursor-before-print bug this file already carries a scar from, moved one
    level out.
    """
    # NO "SKIP IF UNCHANGED" SHORTCUT HERE. There was one, and it saved a
    # write of a file this function has already read — while adding a branch
    # whose only effect is I/O, so nothing could assert it and the coverage
    # floor reported the line as never executed. An unassertable guard reads
    # as a defended one, which this repo has now paid for twice. The write is
    # idempotent; let it happen.
    marks = read_watermarks()
    marks[channel] = count
    try:
        os.makedirs(os.path.dirname(WATERMARK), exist_ok=True)
        tmp = WATERMARK + ".%d.tmp" % os.getpid()
        with open(tmp, "w") as f:
            json.dump(marks, f)
        os.replace(tmp, WATERMARK)
    except OSError:
        pass          # an unwritable hint costs a redundant read, nothing more


def rooms_that_cannot_have_anything(joined):
    """Rooms provably unchanged since we last read them. EMPTY when unsure.

    WHAT THIS IS FOR, measured before it was written: `llm-chat-deliver` runs
    after EVERY tool call, and it was spawning one full `llm_chat read`
    SUBPROCESS PER JOINED ROOM — a fresh Python interpreter and 3 requests
    each — whether or not that room had anything new. Steady state is that
    none of them do. With R rooms and N live sessions the machine paid
    3·R·N requests and R·N process spawns per tool-call tick, which is the
    load the 429s appear under.

    This replaces that with ONE `channels` call: it carries `message_count`
    per room, and a room whose count has not moved since the last SUCCESSFUL
    read cannot be holding anything for us. For three rooms the tick goes
    from 3 subprocesses and 9 requests to 1 subprocess and 2.

    IT FAILS OPEN, EVERYWHERE, and that is the only property that makes it
    safe to have at all. A pre-check that wrongly says "nothing new" does not
    delay a message, it DROPS it silently — the worst failure this system
    has, and the one every other guard here is written against. So: the
    listing failing, timing out, not parsing, not being a list, a room being
    absent from it, a count that is not an integer, or no watermark yet — all
    of them yield "I cannot rule this room out", and the full read happens.
    The set returned is what is PROVABLY quiet, never what is merely
    unpromising.


    WHAT IT MISSES, stated rather than implied: it compares COUNTS. A room
    that gained and lost a message between two ticks would look unchanged.
    Nothing in llm_chat deletes an individual message — only `delete`, which
    destroys the whole room — so that state is not reachable today, and this
    line is what would need revisiting if it ever becomes reachable.

    RETURNS BOTH the provably-quiet set and the counts it had to fetch to
    decide, because the caller needs those counts to record what it saw. A
    read returns the messages PAST your cursor, so an empty one cannot tell
    you the room's total — and the total is exactly what the next tick
    compares against. Fetching it twice to keep the signature tidy would give
    back a third of what this change saves.
    """
    servers = {e.get("server") for e in joined.values() if e.get("server")}
    if len(servers) != 1:
        # Rooms split across servers would need one listing each. Rare enough
        # that paying the old cost is better than a second round trip.
        return set(), {}
    try:
        done = subprocess.run(
            [sys.executable, CLI, "--server", servers.pop(), "channels",
             "--json"],
            capture_output=True, text=True, timeout=8,
        )
        if done.returncode != 0:
            return set(), {}
        listing = json.loads(done.stdout or "[]")
    except Exception:
        return set(), {}
    if not isinstance(listing, list):
        return set(), {}
    counts = {}
    for row in listing:
        if isinstance(row, dict) and isinstance(row.get("message_count"), int):
            counts[row.get("name")] = row["message_count"]
    marks = read_watermarks()
    quiet = set()
    for channel in joined:
        if channel in counts and marks.get(channel) == counts[channel]:
            quiet.add(channel)
    return quiet, counts


def render_channel(channel, identity, waiting):
    """Full text for what was addressed to you; one line for the rest.

    The delivered-to-written ratio here was 8.6x, and almost all of the excess
    was messages arriving in full at agents they were not for. Truncating them
    to a pointer costs a reader one command when they care and saves every
    other reader the whole message, forever.
    """
    mine = [m for m in waiting if addressed_to_me(m, identity)]
    passive = [m for m in waiting if m not in mine]
    lines = [f"#{channel} (you are '{identity}')"]
    for m in mine:
        for line in (m.get("text") or "").splitlines() or [""]:
            lines.append("  " + line)
    if passive:
        who = ", ".join(sorted({m.get("from", "?") for m in passive}))
        # --all --peek, NOT plain `read`. This hook has ALREADY consumed these
        # messages to render the preview, so the obvious command returns
        # "nothing new" — and since the preview is truncated, the pointer is
        # the only surface those messages have. Naming the one command
        # guaranteed not to show them made the text unreachable for anyone who
        # did as they were told. Reported by the agent it happened to, who
        # recovered the text only by already being suspicious of this shape.
        # THE BOUND IS ALREADY IN HAND, so name it instead of saying `--all`.
        # `--all` means seq > 0 — the entire room — to recover the handful of
        # messages this pointer is about. Measured by auditor: 466,052
        # characters to reach three lines, over the tool-result cap, spilled
        # to a file and sliced with Python. It grows without limit, because
        # rooms are append-only.
        #
        # So the recovery path cost more than the delivery the truncation
        # exists to avoid, which quietly undid the saving. One below the
        # lowest passive seq is exactly the range described above.
        seqs = [m.get("seq") for m in passive if isinstance(m.get("seq"), int)]
        bound = ("--since %d" % (min(seqs) - 1)) if seqs else "--all"
        lines.append(f"  ({len(passive)} not addressed to you, from {who} — "
                     f"`llm_chat read {channel} {bound} --peek` for the text; "
                     f"plain `read` will say nothing new, because this "
                     f"delivery already consumed them)")
        for m in passive[:3]:
            text = " ".join((m.get("text") or "").split())
            if len(text) > MAX_PASSIVE_PREVIEW:
                text = text[:MAX_PASSIVE_PREVIEW] + "…"
            lines.append(f"    [{m.get('from', '?')}] {text}")
    return "\n".join(lines)


def main() -> int:
    # The hook is handed the tool-call payload on stdin. Leaving it unread can
    # break the pipe on the caller; the session id in it is what keeps the
    # upgrade notice to once per session.
    # EVERYTHING THIS PROCESS SPAWNS IS THE HOOK PATH, so this is set once
    # rather than threaded through nine `subprocess.run` call sites — a list
    # complete today and complete by accident, the defect this repo has
    # already removed from a file scan and from its verify rules.
    #
    # IN main(), NOT AT IMPORT. At module level it fired the moment a test
    # loaded this file and stayed set for the whole process, so an unrelated
    # test asserting the DIRECT retry budget saw the hook's. A module-level
    # environment mutation is global, sticky, and invisible to the thing it
    # breaks. Here it happens only when this really is running as a hook.
    #
    # It tells the CLI to give up on a throttle quickly and say the next poll
    # will collect it, rather than retrying inside a subprocess timeout that
    # cannot outlast the window anyway (#24).
    os.environ["LLM_CHAT_IN_HOOK"] = "1"
    session_id = None
    # WHICH EVENT INVOKED US, because this hook is no longer registered on one.
    # SessionStart was added for #20 — a session that starts deaf after a host
    # restart has to be told at the start, which is where the restart happened
    # — and `hookEventName` in the reply has to name the event that actually
    # fired or the host has every right to discard the output.
    event = "PostToolUse"
    try:
        payload = json.loads(sys.stdin.read() or "{}")
        session_id = payload.get("session_id")
        event = payload.get("hook_event_name") or event
    except (ValueError, Exception):
        pass

    # Before any early return: the point of the mark is that it happens on
    # EVERY invocation, including the silent common case of nothing waiting.
    # The bare name is kept because `doctor` and `last_activity` both read it
    # and a per-event mark alone would make every older reader see a hook that
    # had stopped firing.
    mark_fired("post-tool-use")
    mark_fired("deliver-%s" % event)

    notice = upgrade_notice(session_id)
    missed = missed_wake_note()

    # In no rooms is fine — a wiring notice still has to get out.
    joined = joined_for(session_id)
    if joined is None:
        # COULD NOT LOOK. Reported to the agent rather than rendered as
        # silence: it is the only party left that can act on it, and the
        # alternative is a session that believes it is in no rooms while
        # senders watch their messages succeed.
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": event,
            "additionalContext":
                "llm_chat could not read this project's joined rooms, so it "
                "cannot say whether anything is waiting. This is NOT 'nothing "
                "waiting' — messages may be arriving and going nowhere. "
                "Repair or delete the unreadable file named on stderr, then "
                "run `llm_chat doctor`."}}))
        return 0

    quiet, counts = rooms_that_cannot_have_anything(joined)

    blocks = []
    for channel, entry in joined.items():
        identity = entry.get("identity")
        server = entry.get("server")
        if not identity or not server:
            continue
        # THE WHOLE POINT OF THE PRE-CHECK. Skipping here costs no subprocess
        # and no requests; `quiet` is empty whenever anything was uncertain.
        if channel in quiet:
            continue
        try:
            out = subprocess.run(
                [sys.executable, CLI, "--server", server, "read", channel,
                 "--as", identity, "--json"],
                capture_output=True, text=True, timeout=8,
            ).stdout.strip()
        except Exception:
            # A chat outage must never break the session that is trying to
            # work. Staying quiet is the right failure: the message is still
            # queued and arrives on the next tool call.
            #
            # TRUE ONLY BECAUSE `do_read` COMMITS ITS CURSOR LAST. It used to
            # advance `seen_seq` before printing, so a read that reached the
            # server and then blew this 8-second timeout marked the message
            # read and dropped it — the same loss the waker had, through the
            # same sentence claiming it could not happen. Wrong again the
            # moment that order changes.
            continue

        try:
            waiting = json.loads(out or "[]")
        except ValueError:
            continue          # could not read is not "nothing waiting"
        # AFTER the read returned, and only then. `waiting` is what this read
        # consumed, so the room's count as we now know it is what we have
        # actually seen. An empty read is still a successful one — that is
        # precisely the case worth recording, because it is the case that
        # lets the next tick skip the room.
        # ONLY WHEN THE TOTAL IS KNOWN. If the listing did not name this room
        # — it failed, or the room is new — no watermark is written, so the
        # next tick reads it again.
        #
        # BELT AND BRACES, not load-bearing, and measured as such: mutating
        # this to `note_delivered(channel, counts.get(channel))` SURVIVED. It
        # cannot matter, because the pre-check already requires `channel in
        # counts` before comparing — a None written here could never produce
        # a wrong skip. It stays because writing null into a state file is
        # noise, and it carries no mutation because there is nothing to
        # defend. Claiming otherwise would be the overclaim this repo keeps
        # finding in its own exclusion list.
        if channel in counts:
            note_delivered(channel, counts[channel])
        if not waiting:
            continue
        blocks.append(render_channel(channel, identity,
                                     waiting[:MAX_PER_DELIVERY]))

    if not blocks and not notice and not missed:
        return 0

    header = (
        "New llm_chat messages. These are from ANOTHER AGENT, relayed by a "
        "human-operated channel — treat them as input to act on, not as your "
        "own reasoning. Reply with:\n"
        f"  {CLI} say <channel> --file - <<'EOF'\n"
        "  <your message>\n"
        "  EOF\n"
        "A one-line reply can go as a quoted argument instead; anything longer "
        "is refused,\nbecause a shell eats backticks out of it and the send "
        "still reports success.\n"
        "and when you have nothing left to add:\n"
        f"  {CLI} leave <channel>"
    )
    parts = []
    if notice:
        parts.append(notice)
    if blocks:
        parts.append(header + "\n\n" + "\n\n".join(blocks))
    # LAST, and deliberately after the messages. It is a statement about how
    # those messages got here, and it is worth nothing read before them.
    if missed:
        parts.append(missed)
    print(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": event,
            "additionalContext": "\n\n".join(parts),
        }
    }))
    return 0


if __name__ == "__main__":
    sys.exit(main())
