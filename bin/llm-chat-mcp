#!/usr/bin/env python3
"""llm-chat-mcp — the llm_chat CLI, spoken over MCP.

Every llm_chat subcommand (open, join, setup, say, sync, mode, pending, read,
leave, reopen, invite, channels, briefing, identify, doctor, fingerprint,
reload) as one MCP tool each, so an MCP client calls `say` with a JSON object
instead of building `llm_chat say <channel> "<text>" --as <identity>` as a
shell string. The CLI does the actual work; this is a translation layer over
stdio, nothing more.

STDLIB ONLY, like every other entrypoint here — an MCP client that spawns this
should not need a `pip install` to talk to it, any more than an agent should
need one to say hello. That rules out the official `mcp` SDK, which is
otherwise the easier way to build this. What is hand-rolled instead is small:
MCP-over-stdio is newline-delimited JSON-RPC 2.0, and this server answers four
methods (`initialize`, `ping`, `tools/list`, `tools/call`) and must never
answer a fifth kind of message — a notification, meaning no `id` in the
frame — even for a method it does not recognise, because the spec forbids a
reply to one.

WHY IT SHELLS OUT RATHER THAN IMPORTING `llm_chat` AS A LIBRARY: every hook in
this repo already does it this way (see `llm-chat-deliver`), for the same
reason — the CLI is the one place identity resolution, the read lock, and the
zonai wire conventions live, and a second copy of any of them drifts from the
first. A subprocess call also gets two things for free that an import would
have to re-earn: argv is a list, never a shell string, so a message
containing quotes or newlines needs no escaping at all; and a CLI crash stays
on the far side of a process boundary instead of taking this server down with
it.

Install by pointing an MCP client at this file, e.g. for Claude Code:

    claude mcp add llm_chat -- python3 /path/to/llm_chat/bin/llm-chat-mcp

`LLM_CHAT_SERVER` and `CLAUDE_PROJECT_DIR` are read from THIS process's
environment and inherited by the CLI subprocess exactly as they would be for
a hook — an MCP server registered for a given project is spawned inside that
project's session, so project_dir() in bin/llm_chat resolves the same way it
does everywhere else.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
CLI = os.path.join(HERE, "llm_chat")

SERVER_NAME = "llm_chat"
SERVER_VERSION = "1.0.0"
DEFAULT_PROTOCOL_VERSION = "2025-06-18"


class ToolError(Exception):
    """A tools/call request refused before ever reaching the CLI — an
    unknown tool name, a missing required argument. Reported as a JSON-RPC
    error rather than a tool result, because the fault is in how the tool was
    CALLED, not in anything llm_chat did."""


def run_cli(argv, timeout):
    """The one seam: every tool call reaches the CLI through here, and only
    here, so a test replaces this single function instead of the shared
    `subprocess` module. Combines stdout and stderr in the order the CLI
    writes them — `SystemExit(msg)` in bin/llm_chat prints its message to
    stderr, and a caller reading only stdout would see nothing at all for
    every error path there is.

    `stdin=DEVNULL`, deliberately: `say --file -` and `briefing --file -`
    read the CLI's own stdin, which without this would be inherited from THIS
    server's stdin — the same pipe `main()` below is reading JSON-RPC frames
    from. A client that passed `file: "-"` would then race this process's own
    read loop against the child's, on the same underlying fd. DEVNULL turns
    that into an immediate, harmless EOF (an empty message) instead of a
    server-wide hang or a corrupted JSON-RPC stream.
    """
    try:
        done = subprocess.run([sys.executable, CLI] + argv,
                              capture_output=True, text=True, timeout=timeout,
                              stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return 1, "timed out after %ds: llm_chat %s" % (timeout, " ".join(argv))
    return done.returncode, (done.stdout or "") + (done.stderr or "")


def _require(arguments, key):
    value = arguments.get(key)
    if not value:
        raise ToolError("'%s' is required" % key)
    return value


def _server_argv(arguments):
    server = arguments.get("server")
    return ["--server", server] if server else []


def _as_flag(a):
    return ["--as", a["identity"]] if a.get("identity") else []


def _topic_flag(a):
    return ["--topic", a["topic"]] if a.get("topic") else []


def _max_messages_flag(a):
    return (["--max-messages", str(a["max_messages"])]
            if a.get("max_messages") is not None else [])


def _build_open(a):
    argv = ["open", _require(a, "channel")] + _as_flag(a)
    if a.get("broadcast"):
        argv += ["--broadcast"]
    argv += _topic_flag(a)
    if a.get("briefing"):
        argv += ["--briefing", a["briefing"]]
    argv += _max_messages_flag(a)
    return argv


def _build_join(a):
    return (["join", _require(a, "channel")] + _as_flag(a) + _topic_flag(a)
            + _max_messages_flag(a))


def _build_setup(a):
    argv = ["setup", _require(a, "channel")] + _as_flag(a) + _topic_flag(a)
    argv += _max_messages_flag(a)
    if a.get("in_checkout"):
        argv += ["--in-checkout"]
    return argv


def _build_say(a):
    argv = ["say", _require(a, "channel")]
    if a.get("text") is not None:
        argv.append(a["text"])
    if a.get("file"):
        argv += ["--file", a["file"]]
    if a.get("to"):
        argv += ["--to", a["to"]]
    if a.get("to_all"):
        argv += ["--to-all"]
    if a.get("to_none"):
        argv += ["--to-none"]
    argv += _as_flag(a)
    return argv


def _build_sync(a):
    return ["sync"]


def _build_mode(a):
    argv = ["mode", _require(a, "channel"), _require(a, "mode")]
    argv += _as_flag(a)
    if a.get("yes"):
        argv += ["--yes"]
    return argv


def _build_pending(a):
    return ["pending", _require(a, "channel")] + _as_flag(a)


def _build_read(a):
    argv = ["read", _require(a, "channel")] + _as_flag(a)
    if a.get("peek"):
        argv += ["--peek"]
    if a.get("all"):
        argv += ["--all"]
    if a.get("json"):
        argv += ["--json"]
    return argv


def _build_leave(a):
    argv = ["leave", _require(a, "channel")] + _as_flag(a)
    if a.get("ask"):
        argv += ["--ask"]
    return argv


def _build_reopen(a):
    return ["reopen", _require(a, "channel")] + _max_messages_flag(a)


def _build_invite(a):
    return ["invite", _require(a, "channel")]


def _build_channels(a):
    argv = ["channels"]
    if a.get("json"):
        argv += ["--json"]
    if a.get("all"):
        argv += ["--all"]
    return argv


def _build_briefing(a):
    argv = ["briefing", _require(a, "channel")]
    if a.get("text") is not None:
        argv.append(a["text"])
    if a.get("file"):
        argv += ["--file", a["file"]]
    argv += _as_flag(a)
    return argv


def _build_identify(a):
    return ["identify", _require(a, "identity")]


def _build_doctor(a):
    return ["doctor"]


def _build_fingerprint(a):
    argv = ["fingerprint"]
    if a.get("of"):
        argv += ["--of", a["of"]]
    return argv


def _build_reload(a):
    argv = ["reload"]
    if a.get("force"):
        argv += ["--force"]
    if a.get("i_know"):
        argv += ["--i-know"]
    return argv


