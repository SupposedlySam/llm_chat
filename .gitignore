# The `zonai` binary IS committed. zonai is a private repo, so a checkout of this
# project cannot fetch it — carrying it here is what makes the repo self-contained.
# It is macOS arm64; see the Gotchas section of the README for other platforms.

# The database and compiled workers.
.zonai/data/
.zonai/executables/
.dart_tool/
.state/

# Never commit: this is per-machine identity, not shared config.
.llm_chat/

# `setup --in-checkout` registers the delivery hook HERE, and install.sh writes
# an absolute path to this machine's checkout. Shared, it points a collaborator's
# agent at a directory that does not exist on their machine — a hook that fails
# after every tool call. Each checkout registers its own.
.claude/settings.json
.claude/settings.json.bak.*

# Bytecode from the Python CLI and delivery hook.
__pycache__/
